# Copy to .env (gitignored) for local runs. For EAS builds set these as EAS environment variables.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Sentry crash reporting. Leave empty to disable (the app runs fine without it).
EXPO_PUBLIC_SENTRY_DSN=
# TODO(source maps), build-time only, set as EAS SECRETS, never commit real values:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Owner app (design v2). Web origin for template previews and the Wise pay page (default https://www.tendso.com).
EXPO_PUBLIC_WEB_ORIGIN=
# Dev / demo only: run the owner path on typed sample data (no backend). Leave empty in real builds.
EXPO_PUBLIC_OWNER_SAMPLE_DATA=
