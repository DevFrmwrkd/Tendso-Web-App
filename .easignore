# EAS archives the Git repository so workspace packages and the root lockfile
# remain available. Keep package.json, package-lock.json, .npmrc, packages/,
# convex/ (including _generated/) and lib/ in the archive.
# A .easignore overrides .gitignore, so repeat private and generated-file rules.
