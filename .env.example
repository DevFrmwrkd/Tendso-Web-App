# Tendso env vars added by the design v2 rollout. Values stay EMPTY here:
# never commit keys. Empty = the feature stays off.
# Where each one is set is in the section heading. The mobile app's are in
# apps/mobile/.env.example (EAS). Full list with notes: docs/FEATURES.md,
# "v2 rollout — env vars to set".

# ============================================================================
# CONVEX deployment  (`npx convex env set NAME value`)
# ============================================================================

# ── Creator program (docs/v2-api-creators.md) ────────────────────────────────
# Salt for hashing visitor IPs on creator-link clicks (convex/http.ts
# /attribution/*). Any long random string. Empty = network matching is off;
# raw IPs are never stored either way.
ATTRIBUTION_IP_SALT=

# ── Owner app (docs/v2-api-owners.md) ────────────────────────────────────────
# Xendit (GCash, Maya, card). Card/e-wallet checkout is off unless BOTH are set.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Optional: where Xendit sends the payer after paying (https:// or tendso://).
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=
# Optional: limit the methods on the checkout, e.g. GCASH,PAYMAYA,CREDIT_CARD (empty = all enabled on the account).
XENDIT_PAYMENT_METHODS=

# Owner emails sent from Convex through Resend (invite / building / ready / live).
# Off when RESEND_API_KEY is empty on the Convex deployment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
# Where "Open Tendso" in owner emails points (app store page or deep link landing).
OWNER_APP_URL=
# Owner-app submits per day across all owners (default 50; 0 closes it).
OWNER_APP_DAILY_LIMIT=

# ── AI site pipeline (docs/v2-ai-pipeline.md) ────────────────────────────────
# Master switch. Off: submissions (and owner-app builds) go to Tendso Studio exactly as before.
AI_PIPELINE_ENABLED=
# Optional. Hand failed runs to Tendso Studio (default on; "false" to stop).
AI_PIPELINE_STUDIO_FALLBACK=
# Optional. Overall deadline in minutes (default 30).
AI_PIPELINE_TIMEOUT_MINUTES=
# Optional. Photos polished per site, cost cap (default 6).
AI_PIPELINE_MAX_POLISHED_PHOTOS=
# Optional. Text LLM order, comma-separated: gemini,groq (default) or groq,gemini.
AI_PIPELINE_LLM_ORDER=
# Optional. Gemini model chain for the pipeline (default: the knowledge-base chain).
AI_PIPELINE_GEMINI_MODELS=
# Optional. Per-image wait for Higgsfield, ms (default 150000).
AI_PIPELINE_IMAGE_TIMEOUT_MS=

# Higgsfield photo polishing. Off unless BOTH the key and the endpoint id are set.
# Key from console.higgsfield.ai as KEY_ID:KEY_SECRET (or the two vars below).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# The Nano Banana image-edit endpoint id from console.higgsfield.ai (no default: not in the public docs).
HIGGSFIELD_IMAGE_ENDPOINT=
# Optional JSON merged into each request body, e.g. {"resolution":"1k","aspect_ratio":"4:3"}.
HIGGSFIELD_IMAGE_PARAMS=
# Optional. API base (default https://api.higgsfield.ai).
HIGGSFIELD_API_BASE=

# ── Landing "Hire an agent" form (app/api/landing-visit, convex/landingLeads.ts) ──
# Cloudflare Turnstile secret and the exact widget hostname.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# ── Convex AND Vercel (same value on both) ───────────────────────────────────
# Shared secret between /api/landing-visit and convex/landingLeads.ts.
LANDING_LEADS_SECRET=

# Already set today, reused by v2 (listed so every need is in one place):
# SELF_SERVE_CREATOR_ID, R2_PUBLIC_URL, GROQ_API_KEY, GROQ_TEXT_MODEL, GEMINI_API_KEY,
# KEY_ENCRYPTION_SECRET, INTERNAL_API_SECRET (Convex AND Vercel, same value),
# NEXT_PUBLIC_APP_URL / SITE_URL (Convex), HYPERAGENT_WEBHOOK_URL / HYPERAGENT_WEBHOOK_TOKEN.

# ============================================================================
# VERCEL (Next.js) — copy to .env.local for local runs
# ============================================================================

# Show the GCash / Maya / Card buttons on /v2/pay/[token] as live ("true"). Anything else leaves them on "Coming soon".
NEXT_PUBLIC_XENDIT_ENABLED=
# Store listings for every "App Store" / "Google Play" button on /v2 (https only).
# The admin "App links" panel (Convex settings app_store_url / play_store_url) wins when set.
# Neither = "Coming soon".
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
# Cloudflare Turnstile site key for the landing "Hire an agent" form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional. Where Convex HTTP actions live (default: NEXT_PUBLIC_CONVEX_URL with .convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=
# Development only: "1" runs the /v2 creator pages on sample data. Ignored in production.
NEXT_PUBLIC_V2_CREATORS_SAMPLE=
