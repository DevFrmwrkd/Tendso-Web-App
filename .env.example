# ── AI site pipeline (docs/v2-ai-pipeline.md) ─────────────────────────────────
# Set on the CONVEX deployment (`npx convex env set NAME value`) unless noted.
# Empty = off. Never commit real values.

# Master switch. Off: submissions go to Tendso Studio exactly as before.
AI_PIPELINE_ENABLED=
# Optional. Hand failed runs to Tendso Studio (default on; "false" to stop).
AI_PIPELINE_STUDIO_FALLBACK=
# Optional. Overall deadline in minutes (default 30).
AI_PIPELINE_TIMEOUT_MINUTES=
# Optional. Photos polished per site, cost cap (default 6).
AI_PIPELINE_MAX_POLISHED_PHOTOS=
# Optional. Text LLM order, comma-separated: gemini,groq (default) or groq,gemini.
AI_PIPELINE_LLM_ORDER=
# Optional. Gemini model chain for the pipeline (default: the knowledge-base chain).
AI_PIPELINE_GEMINI_MODELS=
# Optional. Per-image wait for Higgsfield, ms (default 150000).
AI_PIPELINE_IMAGE_TIMEOUT_MS=

# Higgsfield photo polishing. Off unless BOTH the key and the endpoint id are set.
# Key from console.higgsfield.ai as KEY_ID:KEY_SECRET (or the two vars below).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# The Nano Banana image-edit endpoint id from console.higgsfield.ai (no default: not in the public docs).
HIGGSFIELD_IMAGE_ENDPOINT=
# Optional JSON merged into each request body, e.g. {"resolution":"1k","aspect_ratio":"4:3"}.
HIGGSFIELD_IMAGE_PARAMS=
# Optional. API base (default https://api.higgsfield.ai).
HIGGSFIELD_API_BASE=

# Reused, already set today (listed so the pipeline's needs are in one place):
# GROQ_API_KEY, GROQ_TEXT_MODEL, GEMINI_API_KEY, KEY_ENCRYPTION_SECRET, R2_PUBLIC_URL,
# INTERNAL_API_SECRET (Convex AND Vercel, same value), NEXT_PUBLIC_APP_URL / SITE_URL (Convex).
