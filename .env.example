# Convex deployment env (set with `npx convex env set NAME value`).
# Salt for hashing visitor IPs on creator-link clicks (convex/http.ts
# /attribution/*). Any long random string. Empty = network matching is off;
# raw IPs are never stored either way.
ATTRIBUTION_IP_SALT=

# Env vars added by the owner-app v2 backend (docs/v2-api-owners.md).
# Set them on the CONVEX deployment (`npx convex env set NAME value`), not Vercel,
# unless noted. Leave empty to keep a feature off. Never commit real values.

# Xendit (GCash, Maya, card). Card/e-wallet checkout is off unless BOTH are set.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Optional: where Xendit sends the payer after paying (https:// or tendso://).
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=
# Optional: limit the methods on the checkout, e.g. GCASH,PAYMAYA,CREDIT_CARD (empty = all enabled on the account).
XENDIT_PAYMENT_METHODS=

# Owner emails sent from Convex through Resend (invite / building / ready / live).
# Off when RESEND_API_KEY is empty on the Convex deployment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
# Where "Open Tendso" in owner emails points (app store page or deep link landing).
OWNER_APP_URL=

# Owner-app submits per day across all owners (default 50; 0 closes it).
OWNER_APP_DAILY_LIMIT=

# Already required by /start, reused by the owner app:
# SELF_SERVE_CREATOR_ID=
# R2_PUBLIC_URL=
