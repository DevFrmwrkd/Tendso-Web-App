---
/**
 * autoshop / FaqAP — "questions" accordion on the panel band, laid across two
 * columns. Condensed uppercase summaries with an amber "+" that rotates to "×"
 * on open; concrete answer copy. The first item opens by default (lp-04's
 * designed state). Reads content.faq.items (q / a).
 *
 * lp-04's SERVICE-AREA block, nested in the FAQ's second column in the source,
 * is lifted into its own AreaAP section per the AM content model.
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
const mid = Math.ceil(items.length / 2);
const col1 = items.slice(0, mid);
const col2 = items.slice(mid);
---
{items.length > 0 && (
  <section class="sec seamtop faq" id="faq">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="faq.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="faq.headline" set:html={headline}></h2>}
      </div>
      <div class="faq-grid">
        <div>
          {col1.map((item, i) => (
            <details class="reveal" open={i === 0}>
              <summary><span data-field={`faq.items.${i}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
              <div class="a" data-field={`faq.items.${i}.a`} set:html={item.a}></div>
            </details>
          ))}
        </div>
        <div>
          {col2.map((item, j) => (
            <details class="reveal">
              <summary><span data-field={`faq.items.${mid + j}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
              <div class="a" data-field={`faq.items.${mid + j}.a`} set:html={item.a}></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
<style>
  .faq { background: var(--panel); }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  @media (max-width: 900px) {
    .faq-grid { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .faq-grid > div { min-width: 0; }
    summary > span:first-child { min-width: 0; overflow-wrap: anywhere; }
    summary .pm {
      flex: 0 0 24px; width: 24px; height: 24px; align-self: flex-start;
      display: grid; place-items: center; line-height: 1;
    }
  }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; padding: 20px 0; font-family: var(--cond); font-weight: bold;
    font-size: 22px; text-transform: uppercase; letter-spacing: .02em; display: flex;
    justify-content: space-between; gap: 16px; color: var(--off);
  }
  summary::-webkit-details-marker { display: none; }
  summary .pm { color: var(--amber); font-size: 24px; transition: transform .3s; font-family: var(--sans); }
  details[open] summary .pm { transform: rotate(45deg); }
  details .a { padding: 0 0 20px; color: var(--concrete); max-width: 60ch; font-size: 16px; }
</style>
