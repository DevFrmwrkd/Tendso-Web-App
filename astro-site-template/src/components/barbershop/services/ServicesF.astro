---
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
const sub = services.sub || '';
const items = Array.isArray(services.items) ? services.items : [];
const idx = (i: number) => String(i + 1).padStart(2, '0');
// Two optional chips per row, price first. `price` is a schema field this
// family drew with nothing, so a priced menu could only be published by typing
// the amount into "Note" — and the manifest, which reads the components, then
// hid the Price input as unused. Printed exactly as typed: never parsed,
// converted or totalled, and never invented when the field is empty.
---
{/* OVER-REMOVAL GUARD — gate the SECTION, not just the grid. The grid below was
  already `items.length > 0`, but the header above it was not, so once the
  invented three-row service menu was deleted from lib/astro-builder.ts and
  lib/derive-content-defaults.ts this shipped a kicker, an <h2> "Services we
  provide" and the lead "A quick look at what <name> can help you with." sitting
  on top of nothing at all — a heading over a void, and a promise of a list that
  is not there. Shared by PageF…PageJ, so all five barbershop designs did it.
  55 other Services components already gate the whole section this way.
  Consequence, accepted deliberately: `#services` is then an anchor with no
  target on this design. A nav entry that scrolls nowhere is the lesser fault
  next to a heading advertising services the owner never listed, and it is the
  same systemic dead-nav gap that predates this branch. */}
{items.length > 0 && (
<section class="pad-y svc-sec" id="services">
  <div class="wrap">
    <div class="sect-head reveal">
      <div>
        {tag && <span class="kicker" data-field="services.tag">{tag}</span>}
        {headline && <h2 class="h-sect" data-field="services.headline" set:html={headline}></h2>}
      </div>
      {sub && <p class="lead" data-field="services.sub">{sub}</p>}
    </div>
    {items.length > 0 && (
      <div class="svc-grid reveal">
        {items.map((it: any, i: number) => (
          <div class="svc">
            <span class="no">{idx(i)} · Service</span>
            <h3 data-field={`services.items.${i}.title`}>{it.title}</h3>
            <p data-field={`services.items.${i}.desc`}>{it.desc || it.description || ''}</p>
            {(it.price || it.note) && (
              <span class="chips">
                {it.price && <span class="tag price" data-field={`services.items.${i}.price`}>{it.price}</span>}
                {it.note && <span class="tag" data-field={`services.items.${i}.note`}>{it.note}</span>}
              </span>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
)}
<style>
  .svc-sec { background: var(--paper-2); }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .svc { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 38px 34px; transition: background .3s ease, color .3s ease; }
  .svc:hover { background: var(--ink); color: var(--paper); }
  .svc .no { font-family: var(--cond); font-size: 13px; letter-spacing: .2em; color: var(--brass); font-weight: 600; }
  .svc h3 { font-family: var(--cond); text-transform: uppercase; letter-spacing: .04em; font-weight: 600; font-size: 22px; margin: 18px 0 12px; }
  .svc p { color: var(--muted); font-size: 15px; margin: 0; }
  .svc:hover p { color: var(--muted-light); }
  /* Row of optional chips. flex rather than inline-block so a price and a
     note sit side by side with a real gap instead of butting together. */
  .svc .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .svc .tag { display: inline-block; margin-top: 14px; font-family: var(--cond); text-transform: uppercase; letter-spacing: .18em; font-size: 11px; color: var(--brass); border: 1px solid var(--line); padding: 6px 12px; }
  .svc:hover .tag { color: var(--brass-bright); border-color: var(--line-light); }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .svc-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .svc { padding: 30px 24px; } }
</style>
