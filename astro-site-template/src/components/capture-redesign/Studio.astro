---
import { resolveBusiness } from './business';

interface Props { siteData: any }
const { siteData } = Astro.props;
const b = resolveBusiness(siteData);
const isFood = b.kind === 'food';
const isCraft = b.kind === 'craft';
const isAppointment = ['law', 'clinic', 'spa'].includes(b.kind);
const firstInitial = b.name.trim().slice(0, 1);
const serviceIntro = isFood ? 'Find your next favourite.' : isCraft ? 'Made with purpose. Finished with care.'
  : b.kind === 'law' ? 'A clear place to start.' : b.kind === 'clinic' ? 'Plan the care you need.'
  : b.kind === 'spa' ? 'A little space for yourself.' : b.kind === 'repair' ? 'Tell us what needs attention.'
  : b.kind === 'barber' ? 'Find your everyday look.' : 'Good things, close to home.';
const visitTitle = isAppointment ? 'Let’s plan your visit.' : isFood ? 'There’s a place for you here.'
  : isCraft ? 'Let’s make something considered.' : 'Come say hello.';
const storyTitle = b.kind === 'law' ? 'A space for a useful conversation.' : b.kind === 'clinic' ? 'A considered approach to your visit.'
  : b.kind === 'repair' ? 'The people behind the work.' : isCraft ? 'The details make the difference.'
  : isFood ? 'A little of our story.' : b.kind === 'spa' ? 'Slow down. Feel at home.' : 'Local people. Thoughtful work.';
const links = [{ href: '#offerings', label: b.serviceLabel }, { href: '#story', label: 'About' }, { href: '#visit', label: 'Find us' }];
const mainImage = b.heroImage || b.gallery[0]?.src;
const gallery = b.gallery.slice(0, 3);
---
<!doctype html>
<html lang="en" data-capture-layout="studio" data-business-kind={b.kind}
  style={`--studio-paper:${b.theme.paper};--studio-ink:${b.theme.ink};--studio-accent:${b.theme.accent};--studio-muted:${b.theme.muted}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={b.description} />
    <meta name="theme-color" content={b.theme.paper} />
    <title>{b.name} — {b.headline}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="#top" aria-label={`${b.name}, home`}>
        <span class="brand-mark" aria-hidden="true">{firstInitial}</span>
        <span>{b.name}</span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {links.map(link => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="header-cta" href="#visit">{isAppointment ? 'Arrange a visit' : 'Visit us'}<span aria-hidden="true">↗</span></a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu"><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          {links.map(link => <a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}
          <a href="#visit">{b.cta}<span aria-hidden="true">↗</span></a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero wrap" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow"><span class="small-line" aria-hidden="true"></span>{b.eyebrow}</p>
          <h1 class="hero-title" id="hero-title">{b.headline}</h1>
          <p class="hero-description">{b.description}</p>
          <div class="hero-actions">
            <a class="button button-solid" href="#visit">{b.cta}<svg viewBox="0 0 24 24" width="19" height="19" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <a class="text-link" href="#offerings">{b.serviceLabel}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-visual">
          <figure class="hero-photo">
            {mainImage && <img src={mainImage} alt={`${b.name} — ${b.galleryLabel}`} loading="eager" fetchpriority="high" width="1100" height="1000" />}
            <figcaption><span>{b.name}</span><span>{b.city}</span></figcaption>
          </figure>
          <a href="#visit" class="visit-tile">
            <div><span class="eyebrow">Find your way here</span><strong>{b.city}</strong><span>{isAppointment ? 'Visits by arrangement' : 'A local place to visit'}</span></div>
            <span class="tile-arrow" aria-hidden="true">↗</span>
          </a>
          <div class="image-label" aria-hidden="true">{b.kind === 'craft' ? 'Made with care.' : b.kind === 'food' ? 'Made for your day.' : 'Right here. For you.'}</div>
        </div>
      </section>

      {b.highlights.length > 0 && <section class="highlights wrap" aria-label="At a glance">
        {b.highlights.slice(0, 3).map((highlight, index) => <div><span class="highlight-icon" aria-hidden="true">{index === 0 ? '↗' : index === 1 ? '○' : '+'}</span><p>{highlight}</p></div>)}
      </section>}

      <section id="offerings" class:list={['offerings section wrap', { 'food-offerings': isFood, 'craft-offerings': isCraft }]} aria-labelledby="offerings-title">
        <div class="section-heading">
          <div><p class="eyebrow"><span class="small-line" aria-hidden="true"></span>{b.serviceLabel}</p><h2 id="offerings-title">{serviceIntro}</h2></div>
          <a class="text-link" href="#visit">{isFood ? 'Plan a visit' : 'Ask us about it'}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="service-list">
          {b.services.map((service, index) => <article class="service">
            <span class="service-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="service-copy"><h3>{service.title}</h3><p>{service.description}</p></div>
            {(service.price || service.meta) && <div class="service-note">{service.price && <strong>{service.price}</strong>}{service.meta && <span>{service.meta}</span>}</div>}
          </article>)}
        </div>
      </section>

      <section class="story-band" id="story" aria-labelledby="story-title">
        <div class="story-grid wrap section">
          <div class="story-heading"><p class="eyebrow"><span class="small-line" aria-hidden="true"></span>Behind {b.name}</p><h2 id="story-title">{storyTitle}</h2><span class="story-signature">{b.name}<span aria-hidden="true">↗</span></span></div>
          <div class="story-copy">{b.story.map(paragraph => <p>{paragraph}</p>)}
            <a class="text-link" href="#visit">{isAppointment ? 'Arrange your first visit' : 'Get to know us'}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      {gallery.length > 0 && <section class="section wrap gallery-section" aria-labelledby="gallery-title">
        <div class="section-heading"><div><p class="eyebrow"><span class="small-line" aria-hidden="true"></span>{b.galleryLabel}</p><h2 id="gallery-title">{isCraft ? 'A closer look at the work.' : 'A little look around.'}</h2></div><p class="section-aside">{isCraft ? 'Materials, textures and the thought behind the finish.' : `A feel for ${b.name}, before you visit.`}</p></div>
        <div class:list={['gallery', `gallery-count-${gallery.length}`]}>
          {gallery.map((photo, index) => <figure><div class="gallery-image"><img src={photo.src} alt={photo.alt} loading="lazy" width="1000" height="800" /></div><figcaption><span>{photo.caption || b.galleryLabel}</span><span>{String(index + 1).padStart(2, '0')}</span></figcaption></figure>)}
        </div>
      </section>}

      {b.process.length > 0 && <section class="process-section section wrap" aria-labelledby="process-title">
        <div class="section-heading"><div><p class="eyebrow"><span class="small-line" aria-hidden="true"></span>{isFood ? 'Make yourself at home' : 'From the first hello'}</p><h2 id="process-title">{isFood ? 'A good day starts here.' : 'A simple way to begin.'}</h2></div></div>
        <ol class="process-list">{b.process.map((step, index) => <li><span class="process-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
      </section>}

      {b.faq.length > 0 && <section class="faq-section section wrap" aria-labelledby="faq-title">
        <div class="faq-heading"><p class="eyebrow"><span class="small-line" aria-hidden="true"></span>A few useful answers</p><h2 id="faq-title">Before you<br />come by.</h2><p>Something else on your mind? Get in touch and we’ll help with your question.</p></div>
        <div class="faq-list">{b.faq.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{item.answer}</p></div></details>)}</div>
      </section>}

      <section class="visit-section" id="visit" aria-labelledby="visit-title">
        <div class="visit-inner wrap section">
          <div class="visit-intro"><p class="eyebrow"><span class="small-line" aria-hidden="true"></span>Visit {b.name}</p><h2 id="visit-title">{visitTitle}</h2><p>{isAppointment ? 'Contact us to confirm the appointment details and what to bring.' : 'Find us in the neighbourhood. We’ll be happy to see you.'}</p><a class="button button-solid" href={b.mapHref} target="_blank" rel="noopener noreferrer">Get directions<svg viewBox="0 0 24 24" width="19" height="19" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div>
          <div class="visit-details">
            <div class="detail-row"><span class="detail-label">Find us</span><address>{b.address}</address></div>
            <div class="detail-row"><span class="detail-label">Say hello</span><div class="contact-links">{b.phone && <a href={b.phoneHref}>{b.phone}<span aria-hidden="true">↗</span></a>}{b.email && <a href={b.emailHref}>{b.email}<span aria-hidden="true">↗</span></a>}</div></div>
            {b.hours.length > 0 && <div class="detail-row"><span class="detail-label">Opening hours</span><dl class="hours">{b.hours.map(hour => <div><dt>{hour.days}</dt><dd>{hour.time}</dd></div>)}</dl></div>}
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer wrap"><a class="brand" href="#top"><span class="brand-mark" aria-hidden="true">{firstInitial}</span><span>{b.name}</span></a><p>{b.sample ? 'Fictional sample business · Design preview' : `© ${new Date().getFullYear()} ${b.name}`}</p><a href="#top" class="back-top">Back to top<span aria-hidden="true">↑</span></a></footer>
  </body>
</html>

<style is:global>
  html[data-capture-layout='studio'] { --paper:var(--studio-paper,#f5f4ee); --ink:var(--studio-ink,#172b28); --accent:var(--studio-accent,#245e51); --muted:var(--studio-muted,#59635f); --line:color-mix(in srgb,var(--ink) 16%,transparent); background:var(--paper); color:var(--ink); font-family:'Manrope',Arial,sans-serif; scroll-behavior:smooth; scroll-padding-top:24px; }
  html[data-capture-layout='studio'] *, html[data-capture-layout='studio'] *::before, html[data-capture-layout='studio'] *::after { box-sizing:border-box; }
  html[data-capture-layout='studio'] body { margin:0; min-width:0; }
  html[data-capture-layout='studio'] a { color:inherit; text-decoration:none; }
  html[data-capture-layout='studio'] :focus-visible { outline:3px solid var(--accent); outline-offset:5px; }
  html[data-capture-layout='studio'] img { display:block; width:100%; height:100%; object-fit:cover; }
  html[data-capture-layout='studio'] h1,html[data-capture-layout='studio'] h2,html[data-capture-layout='studio'] h3,html[data-capture-layout='studio'] p,html[data-capture-layout='studio'] figure { margin:0; }
  html[data-capture-layout='studio'] h1,html[data-capture-layout='studio'] h2,html[data-capture-layout='studio'] h3 { text-wrap:balance; overflow-wrap:anywhere; }
  html[data-capture-layout='studio'] .wrap { width:calc(100% - 96px); max-width:1280px; margin-inline:auto; }
  html[data-capture-layout='studio'] .section { padding-block:100px; }
  html[data-capture-layout='studio'] .eyebrow { display:flex; align-items:center; gap:12px; font-size:11px; line-height:1.6; letter-spacing:.1em; font-weight:700; text-transform:uppercase; }
  html[data-capture-layout='studio'] .small-line { flex:none; width:22px; height:2px; background:var(--accent); }
  html[data-capture-layout='studio'] h2 { font-size:clamp(32px,4.3vw,58px); line-height:1.08; font-weight:700; letter-spacing:-.055em; }
  html[data-capture-layout='studio'] h3 { font-size:21px; font-weight:700; line-height:1.25; letter-spacing:-.035em; }
  html[data-capture-layout='studio'] .skip-link { position:fixed; top:12px; left:12px; z-index:99; background:var(--ink); color:white; padding:14px 20px; transform:translateY(-160%); }
  html[data-capture-layout='studio'] .skip-link:focus { transform:translateY(0); }
  html[data-capture-layout='studio'] .site-header { min-height:100px; display:flex; gap:24px; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); }
  html[data-capture-layout='studio'] .brand { display:inline-flex; min-width:0; align-items:center; gap:11px; font-size:18px; font-weight:800; line-height:1.2; letter-spacing:-.045em; }
  html[data-capture-layout='studio'] .brand > span:last-child { overflow-wrap:anywhere; }
  html[data-capture-layout='studio'] .brand-mark { flex:none; display:grid; width:32px; height:32px; place-items:center; background:var(--accent); color:white; border-radius:9px 3px 9px 3px; font-size:19px; letter-spacing:-.08em; font-weight:800; }
  html[data-capture-layout='studio'] .desktop-nav { display:flex; gap:30px; align-items:center; margin-left:auto; font-size:12px; font-weight:600; }
  html[data-capture-layout='studio'] .desktop-nav a { padding-block:12px; }
  html[data-capture-layout='studio'] .desktop-nav a:hover { color:var(--accent); }
  html[data-capture-layout='studio'] .header-cta { display:flex; gap:22px; align-items:center; border:1px solid var(--line); padding:13px 17px; border-radius:4px; font-size:12px; font-weight:700; }
  html[data-capture-layout='studio'] .header-cta:hover { border-color:var(--ink); }
  html[data-capture-layout='studio'] .mobile-menu { display:none; }
  html[data-capture-layout='studio'] .hero { display:grid; grid-template-columns:1fr 1fr; gap:5.5%; padding-block:64px 72px; align-items:center; }
  html[data-capture-layout='studio'] .hero-copy { display:flex; flex-direction:column; align-items:flex-start; min-width:0; }
  html[data-capture-layout='studio'] .hero-eyebrow { margin-bottom:26px; max-width:100%; }
  html[data-capture-layout='studio'] .hero-title { font-size:clamp(50px,5.8vw,86px); line-height:1.035; font-weight:800; letter-spacing:-.067em; max-width:10ch; }
  html[data-capture-layout='studio'] .hero-description { max-width:430px; margin-top:26px; color:var(--muted); font-size:15px; line-height:1.8; }
  html[data-capture-layout='studio'] .hero-actions { display:flex; gap:24px; align-items:center; flex-wrap:wrap; margin-top:28px; }
  html[data-capture-layout='studio'] .button { display:inline-flex; justify-content:space-between; align-items:center; gap:28px; min-height:50px; padding:15px 21px; border-radius:4px; font-size:12px; font-weight:700; line-height:1.5; transition:background .18s,transform .18s; }
  html[data-capture-layout='studio'] .button-solid { background:var(--accent); color:white; }
  html[data-capture-layout='studio'] .button:hover { transform:translateY(-2px); background:var(--ink); }
  html[data-capture-layout='studio'] .text-link { display:inline-flex; align-items:center; justify-content:space-between; gap:16px; padding-block:8px; font-size:12px; line-height:1.6; font-weight:700; border-bottom:1px solid var(--line); }
  html[data-capture-layout='studio'] .text-link:hover { color:var(--accent); border-color:currentColor; }
  html[data-capture-layout='studio'] .hero-visual { display:grid; grid-template-columns:1fr 92px; gap:12px; align-self:stretch; min-width:0; }
  html[data-capture-layout='studio'] .hero-photo { grid-column:1/-1; border-radius:7px; overflow:hidden; position:relative; min-height:390px; background:var(--accent); }
  html[data-capture-layout='studio'] .hero-photo img { position:absolute; inset:0; }
  html[data-capture-layout='studio'] .hero-photo::after { content:''; position:absolute; inset:55% 0 0; background:linear-gradient(transparent,rgba(0,0,0,.5)); pointer-events:none; }
  html[data-capture-layout='studio'] .hero-photo figcaption { position:absolute; z-index:1; inset:auto 22px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px; color:white; font-size:10px; font-weight:600; }
  html[data-capture-layout='studio'] .visit-tile { display:flex; justify-content:space-between; align-items:center; min-width:0; gap:18px; background:white; padding:20px 22px; border-radius:6px; }
  html[data-capture-layout='studio'] .visit-tile div { display:flex; flex-direction:column; gap:5px; min-width:0; }
  html[data-capture-layout='studio'] .visit-tile .eyebrow { font-size:8px; letter-spacing:.08em; color:var(--muted); }
  html[data-capture-layout='studio'] .visit-tile strong { font-size:17px; line-height:1.3; letter-spacing:-.04em; overflow-wrap:anywhere; }
  html[data-capture-layout='studio'] .visit-tile div > span:last-child { font-size:10px; color:var(--muted); }
  html[data-capture-layout='studio'] .tile-arrow { font-size:26px; }
  html[data-capture-layout='studio'] .image-label { display:flex; align-items:flex-end; padding:14px; color:white; background:var(--accent); border-radius:6px; font-size:15px; font-weight:700; line-height:1.25; letter-spacing:-.04em; }
  html[data-capture-layout='studio'] .highlights { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding-block:25px; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  html[data-capture-layout='studio'] .highlights > div { display:flex; gap:15px; align-items:center; min-width:0; padding-inline:26px; border-right:1px solid var(--line); }
  html[data-capture-layout='studio'] .highlights > div:first-child { padding-left:0; }
  html[data-capture-layout='studio'] .highlights > div:last-child { border:0; padding-right:0; }
  html[data-capture-layout='studio'] .highlight-icon { font-size:25px; color:var(--accent); flex:none; }
  html[data-capture-layout='studio'] .highlights p { font-size:12px; font-weight:600; line-height:1.6; }
  html[data-capture-layout='studio'] .section-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:36px; margin-bottom:42px; }
  html[data-capture-layout='studio'] .section-heading > div { max-width:700px; }
  html[data-capture-layout='studio'] .section-heading .eyebrow { margin-bottom:17px; }
  html[data-capture-layout='studio'] .section-heading > .text-link { flex:none; }
  html[data-capture-layout='studio'] .section-aside { font-size:13px; line-height:1.7; color:var(--muted); max-width:245px; }
  html[data-capture-layout='studio'] .service-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:34px; }
  html[data-capture-layout='studio'] .service { display:flex; flex-direction:column; align-items:flex-start; padding-top:24px; border-top:2px solid var(--ink); min-width:0; }
  html[data-capture-layout='studio'] .service-number { font-size:10px; font-weight:700; color:var(--accent); margin-bottom:30px; }
  html[data-capture-layout='studio'] .service h3 { margin-bottom:14px; }
  html[data-capture-layout='studio'] .service p { color:var(--muted); font-size:14px; line-height:1.85; }
  html[data-capture-layout='studio'] .service-note { display:flex; flex-direction:column; gap:6px; padding-top:25px; margin-top:auto; font-size:11px; line-height:1.6; }
  html[data-capture-layout='studio'] .service-note strong { font-size:15px; font-weight:800; color:var(--accent); }
  html[data-capture-layout='studio'] .service-note span { color:var(--muted); }
  html[data-capture-layout='studio'] .food-offerings .service-list { display:block; border-top:2px solid var(--ink); }
  html[data-capture-layout='studio'] .food-offerings .service { display:grid; grid-template-columns:50px 1fr minmax(90px,180px); gap:26px; align-items:start; padding-block:28px; border-top:0; border-bottom:1px solid var(--line); }
  html[data-capture-layout='studio'] .food-offerings .service-number { padding-top:5px; margin:0; }
  html[data-capture-layout='studio'] .food-offerings .service h3 { margin-bottom:7px; }
  html[data-capture-layout='studio'] .food-offerings .service-note { margin:0; padding:3px 0 0; text-align:right; }
  html[data-capture-layout='studio'] .story-band { background:white; }
  html[data-capture-layout='studio'] .story-grid { display:grid; grid-template-columns:1fr 1fr; gap:10%; }
  html[data-capture-layout='studio'] .story-heading .eyebrow { margin-bottom:22px; }
  html[data-capture-layout='studio'] .story-signature { display:flex; align-items:center; justify-content:space-between; border-top:1px solid var(--line); margin-top:44px; padding-top:18px; font-size:12px; font-weight:700; }
  html[data-capture-layout='studio'] .story-signature > span { font-size:23px; color:var(--accent); }
  html[data-capture-layout='studio'] .story-copy { padding-top:38px; }
  html[data-capture-layout='studio'] .story-copy p { font-size:15px; line-height:1.9; color:var(--muted); margin-bottom:20px; }
  html[data-capture-layout='studio'] .story-copy p:first-child { font-size:19px; font-weight:500; letter-spacing:-.02em; line-height:1.65; color:var(--ink); }
  html[data-capture-layout='studio'] .story-copy .text-link { margin-top:8px; }
  html[data-capture-layout='studio'] .gallery { display:grid; grid-template-columns:1.25fr 1fr; gap:24px; }
  html[data-capture-layout='studio'] .gallery figure { min-width:0; }
  html[data-capture-layout='studio'] .gallery-count-1 { display:block; }
  html[data-capture-layout='studio'] .gallery-count-3 figure:first-child { grid-row:span 2; }
  html[data-capture-layout='studio'] .gallery-image { aspect-ratio:5/4; overflow:hidden; border-radius:5px; background:var(--line); }
  html[data-capture-layout='studio'] .gallery-count-1 .gallery-image { aspect-ratio:2/1; }
  html[data-capture-layout='studio'] .gallery-count-3 figure:first-child .gallery-image { height:calc(100% - 31px); aspect-ratio:auto; }
  html[data-capture-layout='studio'] .gallery-count-3 figure:not(:first-child) .gallery-image { aspect-ratio:2/1; }
  html[data-capture-layout='studio'] .gallery figcaption { display:flex; justify-content:space-between; gap:16px; font-size:10px; font-weight:600; line-height:1.5; padding-top:12px; }
  html[data-capture-layout='studio'] .gallery figcaption span:last-child { color:var(--muted); }
  html[data-capture-layout='studio'] .process-section { padding-top:0; }
  html[data-capture-layout='studio'] .process-list { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px; counter-reset:none; }
