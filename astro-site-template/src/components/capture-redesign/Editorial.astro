---
import { resolveBusiness, businessCtaHref } from './business';

interface Props { siteData: any }
const { siteData } = Astro.props;
const b = resolveBusiness(siteData);
const chapter = {
  barber: { story: 'A good cut. A little time for yourself.', work: 'A closer look at the shop.', visit: 'Your next fresh start.' },
  repair: { story: 'The people behind the work.', work: 'Inside the workshop.', visit: 'Let’s take a closer look.' },
  spa: { story: 'Make a little room for yourself.', work: 'A place to slow down.', visit: 'Find your quiet moment.' },
  food: { story: 'Good things, made here.', work: 'From our place to your table.', visit: 'Pull up a chair.' },
  clinic: { story: 'Care starts with a conversation.', work: 'A space for your visit.', visit: 'Plan your next visit.' },
  law: { story: 'Space for a clear conversation.', work: 'A setting for the next step.', visit: 'Bring your questions.' },
  craft: { story: 'Thoughtfully made. Carefully finished.', work: 'An eye for the details.', visit: 'Let’s make something together.' },
  other: { story: 'A familiar place, close to home.', work: 'A little look around.', visit: 'We’re around the corner.' },
}[b.kind];
const services = b.services;
const gallery = b.gallery;
const phoneHref = b.phoneHref || undefined;
const emailHref = b.emailHref || undefined;
const mapHref = b.mapHref;
const primaryHref = phoneHref || emailHref || b.mapHref;
const heroHref = businessCtaHref(b, { services: '#services', story: '#story', gallery: '#gallery', visit: '#visit' });
const cssVars = `--ed-paper:${b.theme.paper};--ed-ink:${b.theme.ink};--ed-accent:${b.theme.accent};--ed-muted:${b.theme.muted};`;
---

<!doctype html>
<html data-template-code={b.code} lang="en" data-capture-layout="editorial" data-capture-kind={b.kind} style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={b.description} />
    {b.favicon && <link rel="icon" href={b.favicon} />}
    <meta property="og:title" content={b.name} />
    {b.description && <meta property="og:description" content={b.description} />}
    {b.ogImage && <meta property="og:image" content={b.ogImage} />}
    <title>{b.name} — {b.headline}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {b.overrideFontHref && <link href={b.overrideFontHref} rel="stylesheet" />}
    {b.overrideCss && <style is:inline set:html={b.overrideCss} />}
    {b.hasColorOverride && <style is:inline set:html={"html[data-capture-layout=\"editorial\"]{--ed-paper:var(--paper)!important;--ed-ink:var(--ink)!important;--ed-accent:var(--accent)!important;--ed-muted:var(--ink-soft)!important}"} />}
    {b.hasFontOverride && <style is:inline set:html={"html[data-capture-layout=\"editorial\"]{--ed-sans:var(--sans)!important;--ed-serif:var(--disp)!important}"} />}
  </head>
  <body id="top">
    <a class="ed-skip" href="#main">Skip to content</a>
    <header class="ed-header ed-wrap">
      <a class="ed-wordmark" href="#top" aria-label={`${b.name} home`} data-field="business_name">{b.name}<span aria-hidden="true">.</span></a>
      <nav class="ed-desktop-nav" aria-label="Main navigation">
        {b.visible.services && <a href="#services">{b.serviceLabel}</a>}
        {b.visible.story && <a href="#story">Our story</a>}
        {b.visible.visit && <a class="ed-nav-cta" href="#visit">{b.cta}<span aria-hidden="true">↗</span></a>}
      </nav>
      <details class="ed-mobile-menu">
        <summary aria-label="Open navigation"><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          {b.visible.services && <a href="#services">{b.serviceLabel}</a>}
          {b.visible.story && <a href="#story">Our story</a>}
          {b.visible.gallery && <a href="#gallery">{b.galleryLabel}</a>}
          {b.visible.visit && <a href="#visit">{b.cta}</a>}
        </nav>
      </details>
    </header>

    <main id="main">
      {b.visible.hero && <section data-template-block="HERO" class:list={["ed-hero ed-wrap", (!b.visible.heroImage || !b.heroImage) && "ed-hero-text-only"]} aria-labelledby={b.visible.heroHeadline ? 'ed-title' : undefined}>
        <div class="ed-hero-copy">
          <p class="ed-eyebrow"><span class="ed-dot" aria-hidden="true"></span><span data-field="hero.kicker">{b.eyebrow}</span></p>
          {b.visible.heroHeadline && <h1 id="ed-title" data-field="hero.headline">{b.headline}</h1>}
          {b.visible.heroDescription && b.description && <p class="ed-description" data-field="hero.sub">{b.description}</p>}
          {b.visible.heroButton && heroHref && <a class="ed-button" href={heroHref} data-href-field="hero.cta1.href"><span data-field="hero.cta1.text">{b.cta}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>}
          {b.visible.services && <a class="ed-text-link" href="#services">Explore {b.serviceLabel.toLowerCase()}<span aria-hidden="true">↓</span></a>}
        </div>
        {b.visible.heroImage && b.heroImage && <figure class="ed-hero-figure">
          <div class="ed-photo-frame"><img data-image-field="hero.image" src={b.heroImage} alt={`${b.name}, ${b.city}`} fetchpriority="high" width="1000" height="1200" /></div>
          <figcaption><span>{b.name}</span><span>{b.city}<span aria-hidden="true"> ↗</span></span></figcaption>
        </figure>}
      </section>}

      {b.visible.highlights && <div data-template-block="TRUST" class="ed-facts ed-wrap" aria-label="Good to know">
        {b.trustItems.map((highlight, index) => <p><span class="ed-small-number" aria-hidden="true">0{index + 1}</span><span>{highlight.num && <strong data-field={`trust.cells.${highlight.fieldIndex}.num`}>{highlight.num} </strong>}<span data-field={`trust.cells.${highlight.fieldIndex}.label`}>{highlight.label}</span></span></p>)}
      </div>}

      {b.visible.services && <section data-template-block="SERVICES" class="ed-services ed-wrap ed-section" id="services" aria-labelledby={b.visible.serviceHeading ? 'ed-services-title' : undefined}>
        <div class="ed-section-intro">
          <p class="ed-eyebrow">01 / {b.serviceLabel}</p>
          {b.visible.serviceHeading && <h2 id="ed-services-title" data-field="services.headline">{b.serviceHeading || (b.kind === 'food' ? 'Something to look forward to.' : b.kind === 'law' ? 'A place to start.' : b.kind === 'craft' ? 'Made with a point of view.' : 'The little things, done well.')}</h2>}
          <p class="ed-section-note">{b.kind === 'food' ? 'Take a look at what we make. Ask us about today’s availability when you visit.' : b.kind === 'clinic' ? 'Get in touch to discuss your visit and the services available.' : b.kind === 'law' ? 'Arrange a conversation about your situation and the work you may need.' : 'Find what you need, then get in touch. We’ll help you plan the details.'}</p>
        </div>
        <div class="ed-service-list">
          {b.visible.serviceList && services.map((service, index) => <article class="ed-service">
            <span class="ed-service-index" aria-hidden="true">0{index + 1}</span>
            <div><h3 data-field={`services.items.${service.fieldIndex}.title`}>{service.title}</h3><p data-field={`services.items.${service.fieldIndex}.desc`}>{service.description}</p>{service.meta && <span class="ed-service-meta" data-field={`services.items.${service.fieldIndex}.note`}>{service.meta}</span>}</div>
            {service.price && <span class="ed-service-price" data-field={`services.items.${service.fieldIndex}.price`}>{service.price}</span>}
          </article>)}
        </div>
      </section>}

      {b.visible.story && <section data-template-block="ABOUT" class="ed-story" id="story" aria-labelledby={b.visible.storyHeading ? 'ed-story-title' : undefined}>
        <div class="ed-wrap ed-story-grid">
          <div class="ed-story-heading"><p class="ed-eyebrow">02 / The story</p>{b.visible.storyHeading && <h2 id="ed-story-title" data-field="about.headline">{b.storyTitle || chapter.story}</h2>}<span class="ed-story-mark" aria-hidden="true">✳</span></div>
          <div class="ed-story-text">{b.visible.storyDescription && b.storyLead && <p data-field="about.lead">{b.storyLead}</p>}{b.visible.storyDescription && b.story.map((paragraph, index) => <p data-field={`about.paragraphs.${index}`}>{paragraph}</p>)}<p class="ed-signature">{b.name}<span>{b.city}</span></p></div>
        </div>
      </section>}

      {b.visible.gallery && <section data-template-block="GALLERY" class="ed-gallery ed-wrap ed-section" id="gallery" aria-labelledby={b.visible.galleryHeading ? 'ed-gallery-title' : undefined}>
        <div class="ed-gallery-heading"><div><p class="ed-eyebrow">03 / {b.galleryLabel}</p>{b.visible.galleryHeading && <h2 id="ed-gallery-title" data-field="gallery.headline">{b.galleryHeading || chapter.work}</h2>}</div><p>{b.name}<br />{b.city}</p></div>
        <div class:list={['ed-gallery-grid', gallery.length === 1 && 'ed-single-image']}>
          {b.visible.galleryItems && gallery.map((image, index) => <figure><div class="ed-gallery-image"><img data-image-field={`gallery.items.${image.fieldIndex}.image`} src={image.src} alt={image.alt || image.caption || `${b.name} detail ${index + 1}`} loading="lazy" width="1000" height="800" /></div><figcaption><span data-field={`gallery.items.${image.fieldIndex}.caption`}>{image.caption || b.name}</span><span aria-hidden="true">0{index + 1}</span></figcaption></figure>)}
        </div>
      </section>}

      {b.visible.process && <section data-template-block="HOW-IT-WORKS" class="ed-process ed-wrap ed-section" aria-labelledby="ed-process-title">
        <div class="ed-process-heading"><p class="ed-eyebrow">A little planning</p><h2 id="ed-process-title" data-field="how.headline">{b.processHeading || "Easy from the start."}</h2></div>
        <ol>{b.process.map((step, index) => <li><span aria-hidden="true">0{index + 1}</span><div><h3 data-field={`how.steps.${step.fieldIndex}.title`}>{step.title}</h3><p data-field={`how.steps.${step.fieldIndex}.body`}>{step.description}</p></div></li>)}</ol>
      </section>}

      {b.visible.faq && <section data-template-block="FAQ" class="ed-faq ed-wrap ed-section" aria-labelledby="ed-faq-title">
        <div class="ed-section-intro"><p class="ed-eyebrow">Before you come by</p><h2 id="ed-faq-title" data-field="faq.headline">{b.faqHeading || "Good to know."}</h2></div>
        <div class="ed-faq-list">{b.faq.map((item, index) => <details><summary><span class="ed-faq-question" data-field={`faq.items.${item.fieldIndex}.q`}>{item.question}</span><span aria-hidden="true">+</span></summary><p data-field={`faq.items.${item.fieldIndex}.a`}>{item.answer}</p></details>)}</div>
      </section>}

      {b.visible.visit && <section data-template-block="LOCATION" class="ed-visit ed-wrap ed-section" id="visit" aria-labelledby="ed-visit-title">
        <div class="ed-visit-intro"><p class="ed-eyebrow">04 / Come find us</p><h2 id="ed-visit-title" data-field="location.headline">{b.visitHeading || chapter.visit}</h2>{primaryHref && <a class="ed-button" href={primaryHref}><span data-field="hero.cta1.text">{b.cta}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>}</div>
        <div class="ed-visit-details">
          {b.address && <div><h3>Find us</h3><p class="ed-address" data-field="location.address">{b.address}</p><a class="ed-text-link" href={mapHref} target="_blank" rel="noopener noreferrer">Get directions<span aria-hidden="true">↗</span></a></div>}
          {b.hours.length > 0 && <div><h3>Opening hours</h3><dl data-field="location.hours">{b.hours.map(hour => <div><dt>{hour.days}</dt><dd>{hour.time}</dd></div>)}</dl></div>}
          {(phoneHref || emailHref) && <div class="ed-contact"><h3>Let’s talk</h3>{phoneHref && <a href={phoneHref} data-field="location.phone">{b.phone}</a>}{emailHref && <a href={emailHref} data-field="contact.email">{b.email}</a>}</div>}
        </div>
      </section>}
    </main>

    {b.visible.footer && <footer data-template-block="FOOTER" class="ed-footer ed-wrap"><a class="ed-wordmark" href="#top" data-field="footer.brand">{b.footerBrand}<span aria-hidden="true">.</span></a><p>{b.visible.footerBlurb && b.footerBlurb && <span data-field="footer.blurb">{b.footerBlurb}</span>}{b.city}{b.sample && <span>Fictional business · Design example</span>}</p><a href="#top" class="ed-back-top">Back to top<span aria-hidden="true">↑</span></a></footer>}
  </body>
</html>

<style is:global>
  html[data-capture-layout='editorial'] { --ed-serif:'Instrument Serif',Georgia,serif; --ed-sans:'Manrope',Arial,sans-serif; --ed-line:color-mix(in srgb,var(--ed-ink) 19%,transparent); background:var(--ed-paper,#f6f3eb); color:var(--ed-ink,#233329); font-family:var(--ed-sans); scroll-behavior:smooth; scroll-padding-top:24px; }
  html[data-capture-layout='editorial'] *,html[data-capture-layout='editorial'] *::before,html[data-capture-layout='editorial'] *::after { box-sizing:border-box; }
  html[data-capture-layout='editorial'] body { margin:0; min-width:0; }
  html[data-capture-layout='editorial'] :where(h1,h2,h3,p,figure,dl,dd,ol) { margin:0; }
  html[data-capture-layout='editorial'] a { color:inherit; text-decoration:none; }
  html[data-capture-layout='editorial'] img { display:block; width:100%; height:100%; object-fit:cover; }
  html[data-capture-layout='editorial'] ::selection { background:var(--ed-accent); color:var(--ed-paper); }
  html[data-capture-layout='editorial'] :focus-visible { outline:2px solid var(--ed-accent); outline-offset:6px; }
  html[data-capture-layout='editorial'] .ed-wrap { width:min(1320px,calc(100% - 112px)); margin-inline:auto; }
  html[data-capture-layout='editorial'] .ed-skip { position:absolute; z-index:20; top:8px; left:8px; padding:12px 18px; background:var(--ed-ink); color:var(--ed-paper); transform:translateY(-150%); }
  html[data-capture-layout='editorial'] .ed-skip:focus { transform:translateY(0); }
  html[data-capture-layout='editorial'] .ed-header { min-height:112px; display:flex; align-items:center; justify-content:space-between; gap:32px; border-bottom:1px solid var(--ed-line); }
  html[data-capture-layout='editorial'] .ed-wordmark { font-family:var(--ed-serif); font-size:32px; letter-spacing:-.045em; line-height:1; max-width:430px; overflow-wrap:anywhere; }
  html[data-capture-layout='editorial'] .ed-wordmark>span { color:var(--ed-accent); }
  html[data-capture-layout='editorial'] .ed-desktop-nav { display:flex; align-items:center; gap:34px; font-size:12px; font-weight:600; }
  html[data-capture-layout='editorial'] .ed-desktop-nav a { padding-block:15px; }
  html[data-capture-layout='editorial'] .ed-nav-cta { display:flex; align-items:center; gap:32px; border-bottom:1px solid var(--ed-ink); }
  html[data-capture-layout='editorial'] .ed-nav-cta>span { font-size:20px; }
  html[data-capture-layout='editorial'] .ed-mobile-menu { display:none; }
  html[data-capture-layout='editorial'] .ed-hero { display:grid; grid-template-columns:1fr 1.04fr; align-items:center; gap:7%; padding-block:66px 58px; }
  html[data-capture-layout='editorial'] .ed-hero-copy { padding-block:15px; min-width:0; }
  html[data-capture-layout='editorial'] .ed-eyebrow { display:flex; align-items:center; gap:10px; font-size:10px; font-weight:600; letter-spacing:.13em; line-height:1.7; text-transform:uppercase; overflow-wrap:anywhere; }
  html[data-capture-layout='editorial'] .ed-dot { width:6px; height:6px; flex:0 0 6px; border-radius:50%; background:var(--ed-accent); }
  html[data-capture-layout='editorial'] h1 { font-family:var(--ed-serif); font-weight:400; font-size:clamp(66px,7.1vw,112px); line-height:.98; letter-spacing:-.042em; margin-top:24px; text-wrap:balance; overflow-wrap:anywhere; }
  html[data-capture-layout='editorial'] .ed-description { max-width:390px; margin-top:29px; color:var(--ed-muted); font-size:16px; line-height:1.85; }
  html[data-capture-layout='editorial'] .ed-button { display:inline-flex; justify-content:space-between; align-items:center; gap:35px; min-height:51px; padding:15px 19px; background:var(--ed-ink); color:var(--ed-paper); font-size:11px; font-weight:600; line-height:1.6; transition:background .2s,transform .2s; }
  html[data-capture-layout='editorial'] .ed-button:hover { background:var(--ed-accent); }
  html[data-capture-layout='editorial'] .ed-button:active { transform:translateY(1px); }
  html[data-capture-layout='editorial'] .ed-button svg { width:19px; height:19px; flex:0 0 19px; fill:none; stroke:currentColor; stroke-width:1.3; }
  html[data-capture-layout='editorial'] .ed-hero-copy>.ed-button { margin-top:31px; }
  html[data-capture-layout='editorial'] .ed-text-link { display:inline-flex; justify-content:space-between; align-items:center; gap:20px; font-size:11px; font-weight:600; line-height:1.8; border-bottom:1px solid currentColor; padding-bottom:3px; }
  html[data-capture-layout='editorial'] .ed-hero-copy>.ed-text-link { display:flex; width:max-content; max-width:100%; margin-top:26px; }
  html[data-capture-layout='editorial'] .ed-photo-frame { aspect-ratio:4/4.9; max-height:660px; background:color-mix(in srgb,var(--ed-ink) 10%,var(--ed-paper)); overflow:hidden; }
  html[data-capture-layout='editorial'] .ed-photo-frame img { object-position:center; }
  html[data-capture-layout='editorial'][data-capture-kind='law'] .ed-photo-frame img,html[data-capture-layout='editorial'][data-capture-kind='clinic'] .ed-photo-frame img { object-position:54% center; }
  html[data-capture-layout='editorial'] figcaption { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; padding-top:15px; font-size:9px; text-transform:uppercase; letter-spacing:.09em; line-height:1.7; }
  html[data-capture-layout='editorial'] figcaption>span { min-width:0; overflow-wrap:anywhere; }
  html[data-capture-layout='editorial'] figcaption>span:last-child { text-align:right; }
  html[data-capture-layout='editorial'] .ed-facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding-block:26px; border-block:1px solid var(--ed-line); }
  html[data-capture-layout='editorial'] .ed-facts p { display:flex; align-items:center; gap:16px; font-size:10px; font-weight:500; line-height:1.7; padding-inline:22px; border-left:1px solid var(--ed-line); }
  html[data-capture-layout='editorial'] .ed-facts p:first-child { padding-left:0; border:0; }
  html[data-capture-layout='editorial'] .ed-small-number { color:var(--ed-accent); font-size:9px; }
  html[data-capture-layout='editorial'] .ed-section { padding-block:105px; }
  html[data-capture-layout='editorial'] h2 { font-family:var(--ed-serif); font-weight:400; font-size:clamp(44px,4.6vw,68px); line-height:1.03; letter-spacing:-.035em; text-wrap:balance; overflow-wrap:anywhere; }
  html[data-capture-layout='editorial'] .ed-section-intro h2 { margin-top:23px; max-width:385px; }
  html[data-capture-layout='editorial'] .ed-section-note { margin-top:25px; font-size:15px; line-height:1.85; color:var(--ed-muted); max-width:280px; }
  html[data-capture-layout='editorial'] .ed-services { display:grid; grid-template-columns:.85fr 1.15fr; gap:10%; }
  html[data-capture-layout='editorial'] .ed-service { display:grid; grid-template-columns:28px minmax(0,1fr) auto; gap:16px; padding-block:28px; border-top:1px solid var(--ed-line); }
  html[data-capture-layout='editorial'] .ed-service:last-child { border-bottom:1px solid var(--ed-line); }
  html[data-capture-layout='editorial'] .ed-service-index { color:var(--ed-accent); font-size:10px; padding-top:8px; }
  html[data-capture-layout='editorial'] .ed-service h3 { font-family:var(--ed-serif); font-size:29px; font-weight:400; line-height:1.15; letter-spacing:-.015em; overflow-wrap:anywhere; }
  html[data-capture-layout='editorial'] .ed-service p { font-size:15px; line-height:1.85; color:var(--ed-muted); margin-top:11px; max-width:340px; }
  html[data-capture-layout='editorial'] .ed-service-meta { display:block; font-size:8px; line-height:1.7; letter-spacing:.08em; text-transform:uppercase; margin-top:14px; color:var(--ed-accent); }
  html[data-capture-layout='editorial'] .ed-service-price { padding-top:8px; font-size:14px; line-height:1.8; white-space:nowrap; }
  html[data-capture-layout='editorial'] .ed-story { background:var(--ed-ink); color:var(--ed-paper); }
  html[data-capture-layout='editorial'] .ed-story-grid { padding-block:95px; display:grid; grid-template-columns:1fr 1fr; gap:12%; }
  html[data-capture-layout='editorial'] .ed-story h2 { margin-top:27px; font-size:clamp(46px,4.6vw,70px); max-width:470px; }
  html[data-capture-layout='editorial'] .ed-story-mark { display:block; font-size:64px; line-height:1; margin-top:35px; color:color-mix(in srgb,var(--ed-paper) 70%,transparent); }
  html[data-capture-layout='editorial'] .ed-story-text { padding-top:45px; }
  html[data-capture-layout='editorial'] .ed-story-text>p:not(.ed-signature) { font-size:15px; line-height:1.95; margin-bottom:20px; color:color-mix(in srgb,var(--ed-paper) 82%,transparent); }
  html[data-capture-layout='editorial'] .ed-signature { display:flex; flex-direction:column; gap:8px; border-top:1px solid color-mix(in srgb,var(--ed-paper) 25%,transparent); padding-top:25px; margin-top:35px; font-family:var(--ed-serif); font-size:26px; }
  html[data-capture-layout='editorial'] .ed-signature>span { font-family:var(--ed-sans); font-size:9px; letter-spacing:.13em; text-transform:uppercase; }
  html[data-capture-layout='editorial'] .ed-gallery-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:30px; margin-bottom:37px; }
  html[data-capture-layout='editorial'] .ed-gallery h2 { margin-top:20px; max-width:550px; }
  html[data-capture-layout='editorial'] .ed-gallery-heading>p { text-align:right; font-size:10px; line-height:1.9; color:var(--ed-muted); }
  html[data-capture-layout='editorial'] .ed-gallery-grid { display:grid; grid-template-columns:1.35fr 1fr 1fr; align-items:start; gap:22px; }
  html[data-capture-layout='editorial'] .ed-gallery-image { aspect-ratio:4/5; overflow:hidden; background:var(--ed-line); }
  html[data-capture-layout='editorial'] .ed-gallery-grid figure:nth-child(2) { margin-top:70px; }
  html[data-capture-layout='editorial'] .ed-gallery-grid figure:nth-child(3) { margin-top:135px; }
  html[data-capture-layout='editorial'] .ed-single-image { grid-template-columns:1fr; }
  html[data-capture-layout='editorial'] .ed-single-image .ed-gallery-image { aspect-ratio:2.05/1; max-height:600px; }
