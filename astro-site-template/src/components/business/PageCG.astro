---
/**
 * Spa Editorial — approved category-specific business template.
 * @template-blocks HERO:heroSection TRUST:trustBlock SERVICES:servicesSection ABOUT:aboutSection GALLERY:gallerySection HOW-IT-WORKS:howItWorksBlock FAQ:faqBlock LOCATION:locationBlock FOOTER:contactSection
 */
import Editorial from '../capture-redesign/Editorial.astro';
interface Props { siteData: any }
const { siteData } = Astro.props;
// The canonical code fixes the category while retaining all customer content.
const prepared = { ...siteData, customizations: { ...(siteData?.customizations ?? {}), heroStyle: "business:CG" }, content: { ...(siteData?.content ?? {}), business_type: "Spa/Massage" } };
---
<Editorial siteData={prepared} />
