---
/**
 * woodworks / CredentialsBV — the quiet ledger under the reviews: four
 * columns of a Young Serif title over one muted line, on the linen ground
 * with a hairline beneath. The design draws no heading here; the titles are
 * the content.
 *
 * Editable hooks:
 *   credentials.items.${i}.title · credentials.items.${i}.body
 * (canonical keys; legacy label / detail / desc spellings are read for
 * display only).
 *
 * NEVER FABRICATED — the highest-risk block on the page: a sourcing claim, a
 * warranty, a registration or payment terms are the owner's to state. There
 * is no derived default, so with no filled row the whole section is absent.
 * No seal, badge or tick is drawn: a drawn badge is a visual claim of
 * certification. Title and body are guarded independently; blank rows are
 * dropped with their ORIGINAL index kept.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const str = (v: unknown): string =>
  typeof v === 'string' ? v.trim() : (typeof v === 'number' && Number.isFinite(v) ? String(v) : '');
const c = content as any;
const cr = (c.credentials && typeof c.credentials === 'object' && !Array.isArray(c.credentials)) ? c.credentials : {};
const items: any[] = Array.isArray(cr.items) ? cr.items : (Array.isArray(c.credentials) ? c.credentials : []);
const rows = items
  .map((it: any, i: number) => ({
    title: str(it?.title) || str(it?.label),
    body: str(it?.body) || str(it?.desc) || str(it?.detail) || str(it?.description),
    i,
  }))
  .filter((r: { title: string; body: string }) => Boolean(r.title || r.body));
---
{rows.length > 0 && (
  <section class="cred" id="credentials">
    <div class="wrap cred-grid">
      {rows.map((r: { title: string; body: string; i: number }) => (
        <div class="cred-it">
          {r.title && <h3 class="cred-t" data-field={`credentials.items.${r.i}.title`}>{r.title}</h3>}
          {r.body && <p class="cred-b" data-field={`credentials.items.${r.i}.body`}>{r.body}</p>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  /* Every value below is the design's inline style, verbatim. */
  .cred { padding: clamp(40px, 5vw, 64px) 0; border-bottom: 1px solid rgba(var(--ink-rgb), .14); }
  .cred-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 24px clamp(24px, 4vw, 48px);
  }
  .cred-it { min-width: 0; }
  .cred-t { font-family: var(--disp); font-weight: 400; font-size: 20px; overflow-wrap: anywhere; }
  .cred-t + .cred-b { margin-top: 4px; }
  /* max-width only binds for a lone item stretched across the row. */
  .cred-b { max-width: 60ch; font-size: 14.5px; color: var(--ink-soft); overflow-wrap: anywhere; }
</style>
