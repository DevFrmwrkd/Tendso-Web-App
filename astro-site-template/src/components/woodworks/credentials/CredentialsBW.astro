---
/**
 * woodworks / CredentialsBW — the paperwork strip on the tinted band: a grid of
 * short records, each a condensed caps title over one line of body copy. No
 * heading — the design draws none, the titles speak for themselves.
 *
 * Editable hooks (all schema-owned):
 *   credentials.items.${i}.title · credentials.items.${i}.body (canonical key;
 *   the value may arrive as desc / detail / description through astro-builder's
 *   alias map, but the hook spells the key the schema declares)
 *
 * THE HIGHEST-RISK BAND IN THE TEMPLATE: registrations, permits, insurance and
 * payment terms are claims only the owner may make. Nothing derives this block,
 * nothing here supplies a row, and no seal, stamp or tick is drawn beside a
 * title (a drawn badge is itself a certification claim). A blank row is dropped
 * with its ORIGINAL index kept; with no filled row the band is omitted.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const cred = (content as any).credentials || {};
const str = (v: any): string => String(v ?? '').trim();
const items: any[] = Array.isArray(cred.items) ? cred.items : (Array.isArray(cred) ? cred : []);
const rows = items
  .map((it: any, i: number) => ({ i, title: str(it?.title ?? it?.label), body: str(it?.body ?? it?.desc ?? it?.detail ?? it?.description) }))
  .filter((r) => Boolean(r.title || r.body));
---
{rows.length > 0 && (
  <section id="credentials" class="cr">
    <div class="wrap cr-grid">
      {rows.map((r) => (
        <div class="cr-item">
          {r.title && <h3 class="cr-t" data-field={`credentials.items.${r.i}.title`}>{r.title}</h3>}
          {r.body && <p class="cr-b" data-field={`credentials.items.${r.i}.body`}>{r.body}</p>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .cr { padding: clamp(36px,5vw,56px) 0; background-color: var(--paper-2); }
  .cr-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,220px), 1fr));
    gap: 20px clamp(20px,3vw,40px);
  }
  .cr-item { min-width: 0; }
  .cr-item .cr-t {
    margin: 0 0 4px; font-family: var(--disp); font-size: 17px; font-weight: 800;
    font-stretch: 90%; line-height: 1.6; text-transform: uppercase; color: var(--ink);
    overflow-wrap: anywhere;
  }
  .cr-item .cr-b {
    margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-soft); overflow-wrap: anywhere;
  }
</style>
