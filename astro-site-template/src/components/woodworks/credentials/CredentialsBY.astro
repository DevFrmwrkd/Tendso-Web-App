---
/**
 * woodworks / CredentialsBY — a quiet centred band of assurances: each a
 * brass Caslon title over one small grey line, in an auto-fit row at a 220px
 * floor (four across on a desktop, two at 768, one on a phone). No head, no
 * rules, no numerals, exactly as drawn.
 *
 * Editable hooks (schema-owned, `credentials` group):
 *   credentials.items.${i}.title · credentials.items.${i}.body
 * The stored value may be the wrapped {items} or a bare array (the schema's
 * fallback), and a row may still carry an AI's label / detail or a legacy
 * desc / description; all are read, and the hooks spell the canonical keys.
 *
 * NEVER FABRICATED — the most claim-dense band on the page: registrations,
 * guarantees, payment terms. Nothing here is supplied by the template; blank
 * rows are dropped (ORIGINAL index kept) and with none left the band is gone.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const txt = (v: any): string => (v == null ? '' : String(v).trim());
const cr = (content as any).credentials;
const cred = cr && typeof cr === 'object' && !Array.isArray(cr) ? cr : {};
const items: any[] = Array.isArray(cred.items) ? cred.items : (Array.isArray(cr) ? cr : []);
const rows = items
  .map((it: any, i: number) => ({
    title: txt(it?.title ?? it?.label),
    body: txt(it?.body ?? it?.desc ?? it?.detail ?? it?.description),
    i,
  }))
  .filter((r) => Boolean(r.title || r.body));
---
{rows.length > 0 && (
  <section id="credentials" class="marks">
    <div class="wrap marks-grid">
      {rows.map((r) => (
        <div class="mk">
          {r.title && <h3 class="mk-t" data-field={`credentials.items.${r.i}.title`}>{r.title}</h3>}
          {r.body && <p class="mk-p" data-field={`credentials.items.${r.i}.body`}>{r.body}</p>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .marks { padding: clamp(40px, 5vw, 64px) 0; background-color: var(--night); color: var(--bone); }
  .marks-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 24px clamp(24px, 4vw, 48px); text-align: center;
  }
  .mk { min-width: 0; }
  /* line-height 1.7: the design states none here, so it inherits the page's. */
  .mk-t {
    margin: 0 0 4px; font-family: var(--disp); font-weight: 400; font-size: 21px;
    line-height: 1.7; color: var(--accent-light); overflow-wrap: break-word;
  }
  .mk-p { margin: 0; font-size: 14px; color: var(--grey); overflow-wrap: break-word; }
</style>
