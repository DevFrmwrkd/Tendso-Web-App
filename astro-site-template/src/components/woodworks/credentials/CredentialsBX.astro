---
/**
 * woodworks / CredentialsBX — "Acacia Studio"'s record (#credentials): a quiet
 * row of serif titles, each over one line of grey detail, on the bone ground.
 * No heading, no badge, no seal — the design draws none, and a drawn seal is a
 * visual claim of certification.
 *
 * Editable hooks:
 *   credentials.items.${i}.title · credentials.items.${i}.body
 *
 * NEVER FABRICATED: nothing derives this block, so it exists only where an
 * admin put something on record. Title and body are guarded separately; blank
 * rows are dropped and every hook keeps the ORIGINAL index (the body hook
 * spells the canonical key even when the value arrived under a legacy name).
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const str = (v: any): string => (v == null ? '' : String(v)).trim();
const cr = (content as any).credentials && !Array.isArray((content as any).credentials) ? (content as any).credentials : {};
const items: any[] = Array.isArray(cr.items) ? cr.items : (Array.isArray((content as any).credentials) ? (content as any).credentials : []);
const rows = items
  .map((it: any, i: number) => ({
    title: str(it?.title ?? it?.label),
    body: str(it?.body ?? it?.desc ?? it?.detail ?? it?.description),
    i,
  }))
  .filter((r) => Boolean(r.title || r.body));
---
{rows.length > 0 && (
  <section id="credentials" class="record">
    <div class="wrap record-grid">
      {rows.map((r) => (
        <div class="record-item">
          {r.title && <h3 class="record-t" data-field={`credentials.items.${r.i}.title`}>{r.title}</h3>}
          {r.body && <p class="record-b" data-field={`credentials.items.${r.i}.body`}>{r.body}</p>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .record { padding: clamp(40px,5vw,64px) 0; }
  .record-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,220px),1fr));
    gap: 24px clamp(24px,4vw,48px);
  }
  .record-item { min-width: 0; }
  .record-t {
    margin: 0 0 4px; font-family: var(--disp); font-weight: 400; font-size: 21px;
    line-height: 1.65; color: var(--ink); overflow-wrap: anywhere;
  }
  .record-t:last-child { margin-bottom: 0; }
  .record-b { margin: 0; font-size: 14.5px; line-height: 1.65; color: var(--ink-soft); overflow-wrap: break-word; }
</style>
