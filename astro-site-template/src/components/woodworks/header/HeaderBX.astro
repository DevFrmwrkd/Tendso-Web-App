---
/**
 * woodworks / HeaderBX — "Acacia Studio"'s sticky rail: a bone bar under a
 * soft blur carrying the Newsreader wordmark, quiet wayfinding links and the
 * ink pill (the header CTA). At <=900px the links fold into a
 * drawer of large serif rows behind a round bone burger, exactly where the
 * design collapses them.
 *
 * Editable hooks:
 *   footer.brand                                     — the wordmark
 *   navbar_links.${i}.label + navbar_links.${i}.href — each nav link (ORIGINAL
 *                                                      index); desktop row and
 *                                                      drawer are ONE element
 *   navCtaText + navCtaHref                          — the ink pill
 *
 * The pill hooks navCtaText (the Header group), so toggling the Hero block off
 * can never hide the header. Its DISPLAY falls back to the hero's primary
 * action, as HeaderBJ does, so a first build is never label-less.
 *
 * With no brand the wordmark is OMITTED ('Your Business' once shipped as a
 * customer's name) and an empty spacer keeps the links and pill on the right.
 * The design has no locality tag beside the mark, so none is drawn.
 *
 * LINKS resolve against the ids this build renders (PageBX's LIVE ANCHORS,
 * passed in as `links`): a nav link to a section that is not on the page is
 * dropped, and the pill falls back to the closing call, then the showroom,
 * then the owner's phone or email. With no wordmark, no link and no pill left,
 * no bar is emitted at all rather than an empty sticky strip.
 *
 * Never visibility-gated. Colour: tokens only. The pill is not .btn and not
 * .nav-cta, so no engine label pin reaches it.
 */
interface Props { layout: any; content: any; links?: { anchors?: string[]; contact?: string }; }
const { layout, content, links } = Astro.props;
// Anchor guard — identical in every BX component that renders an in-page href.
// links.anchors = the ids THIS build renders, links.contact = the owner's own
// tel:/mailto: href; both come from PageBX (LIVE ANCHORS). The content layer
// hard-codes '#visit' / '#services' / '#about' / '#why' / '#work' / '#contact'
// hrefs: an in-page href survives only when its id renders ('work' and
// 'contact' map onto the design's gallery and visit), else onPage() gives ''
// and a LINK is dropped. A primary BUTTON falls back instead — act(): its own
// target, then the design's fallback sections in order, then the contact
// channel — and is left out only when none exists. A secondary button (act2,
// Hero and CtaBand) names its destination, so it is left out when that is a
// design section this build does not render; only an empty or unknown href
// falls back, to a section the primary is not already pointing at, never to
// the contact channel. Off-page hrefs (tel:, mailto:, viber:, http) pass
// through untouched.
const ALL_ANCHORS = ['main', 'top', 'marquee', 'services', 'custom', 'about', 'why', 'gallery', 'how', 'reviews', 'credentials', 'area', 'faq', 'visit', 'book'];
const LIVE = new Set<string>(Array.isArray(links?.anchors) ? links.anchors : ALL_ANCHORS);
const CONTACT = String(links?.contact ?? '').trim();
const ANCHOR_ALIAS: Record<string, string> = { work: 'gallery', contact: 'visit' };
const onPage = (href: any): string => {
  const h = String(href ?? '').trim();
  if (!h.startsWith('#')) return h;
  const id = h.slice(1);
  if (LIVE.has(id)) return h;
  const alias = ANCHOR_ALIAS[id];
  return alias && LIVE.has(alias) ? `#${alias}` : '';
};
const act = (href: any, ...fallbacks: string[]): string => [href, ...fallbacks].map(onPage).find(Boolean) || CONTACT;
const str = (v: any): string => (v == null ? '' : String(v)).trim();
const c = (content as any) || {};
const brand = str(c.footer?.brand || layout?.businessName);
// A label-less or unreachable link is dropped; the ORIGINAL index rides along
// as .i so the editor's per-link hooks stay correct after the filter.
const navLinks: Array<{ label: string; href: string; i: number }> =
  ((Array.isArray(layout?.navLinks) ? layout.navLinks : []) as any[])
    .map((l: any, i: number) => ({ label: str(l?.label), href: onPage(l?.href), i }))
    .filter((l) => l.href && l.label);
const h = c.hero || {};
const ctaText = str(c.navCtaText || h.cta1?.text);
const ctaHref = act(c.navCtaHref || h.cta1?.href, '#book', '#visit');
const hasCta = Boolean(ctaText && ctaHref);
const hasBar = Boolean(brand) || navLinks.length > 0 || hasCta;
---
{hasBar && (
<header class="bar">
  <div class="wrap bar-in">
    {brand
      ? <a class="wm" href="#main" data-field="footer.brand">{brand}</a>
      : <span class="wm-gap" aria-hidden="true"></span>}
    {navLinks.length > 0 && (
      <nav class="bar-nav" id="bar-nav-BX" aria-label="Primary">
        {navLinks.map((link) => (
          <a href={link.href} data-field={`navbar_links.${link.i}.label`} data-href-field={`navbar_links.${link.i}.href`}>{link.label}</a>
        ))}
      </nav>
    )}
    {hasCta && <a class="bar-cta" href={ctaHref} data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>}
    {navLinks.length > 0 && (
      <button class="bar-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="bar-nav-BX">
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    )}
  </div>
</header>
)}
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.bar');
    if (!hdr) return;
    var btn = hdr.querySelector('.bar-burger');
    if (!btn) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () { setOpen(!hdr.classList.contains('open')); });
    // The pill sits OUTSIDE the drawer, so tapping it must close the drawer too.
    hdr.querySelectorAll('.bar-nav a, .bar-cta').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && hdr.classList.contains('open')) { setOpen(false); btn.focus(); }
    });
  })();
</script>
<style>
  .bar {
    position: sticky; top: 0; z-index: 50;
    background-color: rgba(var(--paper-rgb), .95);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .bar-in { height: 72px; display: flex; align-items: center; gap: 18px; }

  /* The wordmark takes the auto margin, so the links, pill and burger stay
     pinned right; the empty spacer does the same job when there is no brand.
     min-width:0 + ellipsis: a long name must not push the pill off at 360px. */
  .wm, .wm-gap { margin-right: auto; min-width: 0; }
  .wm {
    display: block; font-family: var(--disp); font-size: clamp(22px,2.4vw,27px);
    font-weight: 400; line-height: 1.65; letter-spacing: -.01em; color: var(--ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .wm:hover { color: var(--accent-deep); }

  .bar-nav { display: flex; gap: 30px; margin-right: 10px; }
  .bar-nav a {
    font-family: var(--sans); font-size: 15px; font-weight: 500; line-height: 1.65;
    color: var(--ink); white-space: nowrap;
  }
  .bar-nav a:hover { color: var(--accent-deep); }

  /* The ink pill: bone label on ink; hover goes olive, label stays bone. */
  .bar-cta {
    flex: none; display: inline-flex; align-items: center;
    min-height: 44px; padding: 0 20px; border-radius: 999px;
    background-color: var(--ink); color: var(--paper);
    font-family: var(--sans); font-size: 14px; font-weight: 600; line-height: 1.3;
    white-space: nowrap;
  }
  .bar-cta:hover { background-color: var(--accent-deep); color: var(--on-primary); }

  .bar-burger { display: none; }

  /* ONE collapse breakpoint, the design's: links out and burger in at the same
     width, so there is never a band where neither is on screen. */
  @media (max-width: 900px) {
    .bar-nav {
      position: absolute; left: 0; right: 0; top: 100%;
      display: none; flex-direction: column; gap: 0; margin: 0;
      padding: 6px 0 14px; background-color: var(--paper);
      border-bottom: 1px solid var(--line);
      max-height: calc(100vh - 72px); overflow-y: auto;
    }
    .bar.open .bar-nav { display: flex; }
    .bar-nav a {
      min-height: 56px; display: flex; align-items: center;
      padding: 0 var(--gut);
      font-family: var(--disp); font-size: 26px; font-weight: 400; line-height: 1.3;
      white-space: normal; overflow-wrap: anywhere;
    }
    .bar-burger {
      flex: none; display: flex; flex-direction: column; justify-content: center; gap: 6px;
      width: 46px; height: 44px; padding: 0 13px;
      background-color: var(--card); border: 0; border-radius: 999px; cursor: pointer;
    }
    .bar-burger span { display: block; height: 1.5px; background-color: var(--ink); }
    /* display:block (not inline-flex) so text-overflow applies to a long
       owner label; line-height keeps it vertically centred at 44px. */
    .bar-cta {
      display: block; line-height: 44px; max-width: 40vw;
      overflow: hidden; text-overflow: ellipsis;
    }
  }
</style>
