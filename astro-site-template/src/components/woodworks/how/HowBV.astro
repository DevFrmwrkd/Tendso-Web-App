---
/**
 * woodworks / HowBV — the process section, the walnut band: tan eyebrow, linen
 * Young Serif headline, a muted line, then the owner's steps as raised walnut
 * cards, each opened by a big tan numeral. The LAST step is the rust card —
 * the design's finish-line step.
 *
 * Editable hooks:
 *   how.tag · how.headline (set:html) · how.sub
 *   how.steps.${i}.title · how.steps.${i}.body (canonical key, even when the
 *   value arrived under a legacy alias)
 *
 * THE NUMERALS are DERIVED from the DISPLAY index (1, 2, 3 … with no gaps),
 * aria-hidden and carry no hook — chrome, not content (HowBJ's rule). The
 * rust highlight follows the last DISPLAYED step for the same reason.
 *
 * SECTION GATE: at least one filled step; the builder derives the eyebrow for
 * every site, and an eyebrow over an empty band is an empty shell. Blank rows
 * are dropped with their ORIGINAL index kept.
 *
 * Colour: the band, the raised cards and the tan numerals are the fixed wood
 * world. The last card is the rust --fill with the --on-primary numeral and
 * the two soft rust labels (--on-accent-3 title, --on-accent-2 body), which
 * the wrapper re-points to --on-primary under an explicit admin scheme.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const str = (v: unknown): string =>
  typeof v === 'string' ? v.trim() : (typeof v === 'number' && Number.isFinite(v) ? String(v) : '');
const hw = (content as any).how || {};
const tag = str(hw.tag);
const headline = str(hw.headline);
const sub = str(hw.sub);
const steps: any[] = Array.isArray(hw.steps) ? hw.steps : (Array.isArray(hw.items) ? hw.items : []);
const rows = steps
  .map((s: any, i: number) => ({ title: str(s?.title), body: str(s?.body) || str(s?.desc) || str(s?.description), i }))
  .filter((r: { title: string; body: string }) => Boolean(r.title || r.body));
---
{rows.length > 0 && (
  <section class="how" id="how">
    <div class="wrap">
      {tag && <p class="how-tag" data-field="how.tag">{tag}</p>}
      {headline && <h2 class="how-h2" data-field="how.headline" set:html={headline}></h2>}
      {sub && <p class="how-sub" data-field="how.sub">{sub}</p>}
      <ol class="how-grid">
        {rows.map((r: { title: string; body: string; i: number }, k: number) => (
          <li class:list={['how-step', k === rows.length - 1 && 'is-last']}>
            <span class="how-n" aria-hidden="true">{String(k + 1)}</span>
            {r.title && <h3 class="how-t" data-field={`how.steps.${r.i}.title`}>{r.title}</h3>}
            {r.body && <p class="how-b" data-field={`how.steps.${r.i}.body`}>{r.body}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
<style>
  /* Every value below is the design's inline style, verbatim. */
  .how { padding: clamp(56px, 7vw, 112px) 0; background-color: var(--wood); color: var(--on-wood); }
  .how-tag {
    font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase;
    color: var(--tan); overflow-wrap: anywhere;
  }
  .how-h2 {
    font-family: var(--disp); font-weight: 400;
    font-size: clamp(34px, 4.8vw, 64px); line-height: 1.04;
    text-wrap: balance; overflow-wrap: anywhere;
  }
  .how-tag + .how-h2 { margin-top: 14px; }
  /* Owner emphasis: tan on walnut (the wrapper's rust would sink into it). */
  .how-h2 :global(em), .how-h2 :global(i) { color: var(--tan); }
  .how-sub { max-width: 52ch; color: rgba(var(--on-wood-rgb), .8); overflow-wrap: anywhere; }
  .how > .wrap > * + .how-sub { margin-top: 16px; }

  .how-grid {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  .how > .wrap > * + .how-grid { margin-top: clamp(32px, 4vw, 56px); }
  .how-step { min-width: 0; padding: 24px; border-radius: 10px; background-color: var(--wood-2); }
  .how-n { font-family: var(--disp); font-size: 40px; line-height: 1; color: var(--tan); }
  .how-t { font-family: var(--disp); font-weight: 400; font-size: 22px; overflow-wrap: anywhere; }
  .how-n + .how-t { margin-top: 14px; }
  .how-b { font-size: 15px; color: rgba(var(--on-wood-rgb), .8); overflow-wrap: anywhere; }
  .how-t + .how-b { margin-top: 6px; }
  .how-n + .how-b { margin-top: 14px; }

  /* The rust finish-line card. */
  .how-step.is-last { background-color: var(--fill); }
  .is-last .how-n { color: var(--on-primary); }
  .is-last .how-t { color: var(--on-accent-3); }
  .is-last .how-b { color: var(--on-accent-2); }
</style>
