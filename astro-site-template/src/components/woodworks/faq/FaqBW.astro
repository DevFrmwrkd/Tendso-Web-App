---
/**
 * woodworks / FaqBW — common questions on the tinted band: eyebrow and a
 * condensed h2 on the left, a stack of ink-ruled disclosure rows on the right,
 * each a bold question with an orange mono "[+]" at the far end. The first
 * answer starts open, as the design's markup marks it.
 *
 * Editable hooks (all schema-owned):
 *   faq.tag · faq.headline · faq.items.${i}.q · faq.items.${i}.a
 *
 * The "[+]" is a template glyph: aria-hidden and OUTSIDE the question's
 * data-field span, so an inline edit can never write it into the question.
 *
 * NEVER FABRICATED: not one question, answer, fee or policy is supplied here.
 * A row with no question is dropped (the question IS the row's label), with
 * the ORIGINAL index kept on every hook; with no questions the section is
 * omitted. With neither eyebrow nor headline the list takes the row alone.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const faq = (content as any).faq || {};
const str = (v: any): string => String(v ?? '').trim();
const tag = str(faq.tag);
const headline = str(faq.headline);
const items: any[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
const rows = items
  .map((it: any, i: number) => ({ i, q: str(it?.q ?? it?.question), a: str(it?.a ?? it?.answer) }))
  .filter((r) => Boolean(r.q));
---
{rows.length > 0 && (
  <section id="faq" class="fq">
    <div class="wrap fq-in">
      {(tag || headline) && (
        <div class="fq-head">
          {tag && <p class="eyebrow" data-field="faq.tag">{tag}</p>}
          {headline && <h2 class="h2 h2--md" data-field="faq.headline">{headline}</h2>}
        </div>
      )}
      <div class="fq-list">
        {rows.map((r, k) => (
          <details class="fq-item" open={k === 0}>
            <summary class="fq-sum">
              <span class="fq-q" data-field={`faq.items.${r.i}.q`}>{r.q}</span>
              <span class="fq-plus" aria-hidden="true">[+]</span>
            </summary>
            {r.a && <p class="fq-a" data-field={`faq.items.${r.i}.a`}>{r.a}</p>}
          </details>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .fq { padding: clamp(56px,7vw,112px) 0; background-color: var(--paper-2); }
  .fq-in { display: flex; flex-wrap: wrap; gap: 36px clamp(40px,6vw,96px); }
  .fq-head { flex: 1 1 300px; min-width: 0; }
  .fq-list { flex: 1.6 1 440px; min-width: 0; border-top: 1px solid var(--ink); }
  .fq-item { border-bottom: 1px solid var(--ink); }
  .fq-sum {
    display: flex; justify-content: space-between; gap: 16px; padding: 20px 0;
    list-style: none; cursor: pointer;
    font-family: var(--sans); font-size: clamp(17px,1.7vw,20px); font-weight: 700;
    line-height: 1.6; color: var(--ink);
  }
  .fq-sum::-webkit-details-marker { display: none; }
  .fq-sum::marker { content: ''; }
  .fq-q { min-width: 0; overflow-wrap: anywhere; }
  .fq-plus { flex: none; font-family: var(--mono); color: var(--accent-deep); }
  .fq-item .fq-a {
    margin: 0 0 20px; max-width: 60ch; color: var(--ink-soft); overflow-wrap: anywhere;
  }
</style>
