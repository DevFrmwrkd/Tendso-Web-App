---
/**
 * woodworks / WhyBY — "the way we build": a centred Caslon headline over a
 * brass-ruled grid of reasons. Each cell is a brass lozenge glyph, a Caslon
 * title and a grey line; the grid is auto-fit at a 240px floor, so four sit in
 * one row on a desktop, two-by-two at 768 and one column on a phone.
 *
 * Editable hooks (schema-owned, `why` group):
 *   why.headline · why.items.${i}.title · why.items.${i}.body
 * The body is read from `body` (canonical), tolerating the legacy desc /
 * description aliases, and the hook always spells the canonical key.
 *
 * The ◆ is decoration: aria-hidden, bound to nothing, and outside every
 * data-field element so an inline edit can never write it into content.
 *
 * THE RULES. The design rules the grid from the container (top + left) and
 * each cell (right + bottom), which only closes when the last row is full.
 * Here every cell draws all four sides and overlaps its neighbour by 1px, so
 * the lines are identical at four reasons and a short last row (three at 768)
 * ends on a clean edge instead of an open, half-ruled box.
 *
 * NEVER FABRICATED: no reason is supplied here, and the section needs at least
 * one filled row. derive-content-defaults always names a headline after the
 * business, so the headline alone never opens it.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const txt = (v: any): string => (v == null ? '' : String(v).trim());
const why = (content as any).why || {};
const items: any[] = Array.isArray(why.items) ? why.items : (Array.isArray(why) ? why : []);
const rows = items
  .map((it: any, i: number) => ({ title: txt(it?.title), body: txt(it?.body ?? it?.desc ?? it?.description), i }))
  .filter((r) => Boolean(r.title || r.body));
const headline = txt(why.headline);
---
{rows.length > 0 && (
  <section id="why" class="ways">
    <div class="wrap">
      {headline && <h2 class="ways-h" data-field="why.headline" set:html={headline}></h2>}
      <div class:list={['ways-grid', !headline && 'ways-grid--top']}>
        {rows.map((r) => (
          <div class="way">
            <span class="way-mark" aria-hidden="true">◆</span>
            {r.title && <h3 class="way-t" data-field={`why.items.${r.i}.title`}>{r.title}</h3>}
            {r.body && <p class="way-p" data-field={`why.items.${r.i}.body`}>{r.body}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .ways { padding: clamp(56px, 7vw, 112px) 0; background-color: var(--night); color: var(--bone); }
  .ways-h {
    margin: 0 auto; max-width: 20ch; text-align: center;
    font-family: var(--disp); font-weight: 400; font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.04; color: var(--bone); text-wrap: balance; overflow-wrap: break-word;
  }
  /* 1px of padding on the right and bottom absorbs the last column's and last
     row's overlap, so nothing crosses the 360px edge. */
  .ways-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 0; margin-top: clamp(36px, 5vw, 56px); padding: 0 1px 1px 0;
  }
  .ways-grid--top { margin-top: 0; }
  .way {
    min-width: 0; padding: 30px 26px;
    border: 1px solid rgba(var(--accent-rgb), .3); margin: 0 -1px -1px 0;
  }
  .way-mark { color: var(--accent-light); }
  /* line-height 1.7: the design states none here, so it inherits the page's. */
  .way-t {
    margin: 12px 0 8px; font-family: var(--disp); font-weight: 400; font-size: 24px;
    line-height: 1.7; color: var(--bone); overflow-wrap: break-word;
  }
  .way-p { margin: 0; font-size: 15px; color: var(--grey); overflow-wrap: break-word; }
  /* An owner's (or the copy extraction's) <em> in the headline: upright (the
     Caslon has no italic) and in the design's one metal. :global() because
     set:html markup cannot be scoped. */
  .ways-h :global(em), .ways-h :global(i) { font-style: normal; color: var(--accent-light); }
</style>
