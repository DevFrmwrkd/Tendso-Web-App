---
/**
 * florist / LocationBU — the visit block (#visit): eyebrow, Gloock h2, a
 * hairline-ruled definition list (address, hours, phone), a champagne
 * underlined directions link — beside a night map that stretches to the
 * column's height (360px at least).
 *
 * Editable hooks (design paths, kept exactly):
 *   location.tag · location.headline (set:html — the AI and the editor may
 *   mark an <em>, printed upright in champagne as Gloock has no italic) ·
 *   location.address · location.hours ·
 *   location.phone (tel: anchor, data-field ONLY — its href is derived from
 *   the value) · location.directions.text + data-href-field
 *   location.directions.href
 * location.address and location.phone DISPLAY their schema fallbacks
 * (contact.address / contact.phone) exactly as genericContentSchema declares
 * them, so the page and the sidebar box always agree. The hooks stay
 * location.*.
 *
 * The row labels (Address, Hours, Phone) are literal template chrome, each
 * rendered only beside its value. location.hours is the schema's single text
 * line; a legacy array there is not printed under this string hook.
 *
 * MAP, three tiers (LocationBI's rule):
 *   1. coordinates: location.lat/lng, else layout.contact.lat/lng — blank,
 *      non-numeric or out-of-range values are rejected (num()), so a cleared
 *      field never pins the business at 0,0
 *   2. else the address, geocoded client-side through Nominatim
 *   3. else (lookup failed or Leaflet never loaded) the drawn face below,
 *      which PageBU's boot erases before mounting tiles
 * No coordinates AND no address: no map cell at all, and the copy column
 * keeps a reading measure. The literal id="map" and the global names
 * window.__floristBUInitMap / window.__floristBUPending are a contract with
 * PageBU: this section calls the boot if it exists, else parks its arguments
 * in __floristBUPending, which PageBU drains right after defining the boot —
 * so the map mounts however long leaflet.js takes, with no timer to run out.
 *
 * TILES: PageBU mounts the design's own night basemap, CARTO dark_all (the
 * style PageBK uses; lib/carto.ts keys it at publish). The champagne pin sits
 * in its own pane. The map box is its own stacking context so Leaflet's
 * 400/1000 z-indices can never ride over the sticky header.
 *
 * SECTION GATE: a map, or at least one of address / hours / phone. A derived
 * heading alone never renders.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const str = (v: any): string => (v === null || v === undefined ? '' : String(v).trim());
const loc = content.location || {};
const contact = content.contact || {};
const tag = str(loc.tag);
const headline = str(loc.headline);
const address = str(loc.address || contact.address || layout?.contact?.address);
const hours = typeof loc.hours === 'string' ? str(loc.hours) : '';
const phone = str(loc.phone || contact.phone || layout?.contact?.phone);
const phoneHref = phone ? `tel:${phone.replace(/[^0-9+]/g, '')}` : '';
const dirText = str(loc.directions?.text);
// Gate on the TARGET as well as the label: with no link and no address to
// search for, the control would lead nowhere.
const dirHref = str(loc.directions?.href)
  || (address ? `https://maps.google.com/?q=${encodeURIComponent(address.replace(/\n/g, ' '))}` : '');
const num = (v: any, max: number): number | null => {
  if (v === null || v === undefined || String(v).trim() === '') return null;
  const n = Number(v);
  return Number.isFinite(n) && Math.abs(n) <= max ? n : null;
};
const lat = num(loc.lat, 90) ?? num(layout?.contact?.lat, 90);
const lng = num(loc.lng, 180) ?? num(layout?.contact?.lng, 180);
const hasCoords = lat !== null && lng !== null;
const hasAddress = Boolean(address);
const hasMap = hasCoords || hasAddress;
const label = str(layout?.businessName) || address;
const mapAria = label ? `Map showing ${label}` : 'Map';
const hasRows = Boolean(address || hours || phone);
const hasLoc = hasMap || hasRows;
---
{hasLoc && (
  <section id="visit" class="visit">
    <div class:list={['wrap', 'v-grid', !hasMap && 'v-grid--solo']}>
      <div class="v-copy">
        {tag && <p class="kick" data-field="location.tag">{tag}</p>}
        {headline && <h2 class="h2 h2--md v-h2" data-field="location.headline" set:html={headline}></h2>}
        {hasRows && (
          <dl class="v-dl">
            {address && <div class="v-row"><dt>Address</dt><dd data-field="location.address">{address}</dd></div>}
            {hours && <div class="v-row"><dt>Hours</dt><dd data-field="location.hours">{hours}</dd></div>}
            {phone && <div class="v-row"><dt>Phone</dt><dd><a href={phoneHref} data-field="location.phone">{phone}</a></dd></div>}
          </dl>
        )}
        {dirText && dirHref && (
          <a class="linkc v-dir" href={dirHref} target="_blank" rel="noopener noreferrer" data-field="location.directions.text" data-href-field="location.directions.href">{dirText}</a>
        )}
      </div>
      {hasMap && (
        <div class="v-map">
          <div id="map" class="v-mapbox" role="img" aria-label={mapAria}>
            <div class="v-face" aria-hidden="true"><span class="v-pin"></span></div>
          </div>
        </div>
      )}
    </div>
  </section>
)}
{hasLoc && hasCoords && (
  <script is:inline define:vars={{ lat, lng, label }}>
    // Hand-off, not a poll: PageBU defines the boot only AFTER the
    // parser-blocking leaflet.js tag, so on a slow CDN it does not exist yet.
    // Park the arguments; PageBU drains them the moment it defines the boot.
    (function () {
      if (window.__floristBUInitMap) window.__floristBUInitMap(lat, lng, label);
      else window.__floristBUPending = [lat, lng, label];
    })();
  </script>
)}
{hasLoc && !hasCoords && hasAddress && (
  <script is:inline define:vars={{ address, label }}>
    (function () {
      // Same hand-off as the coordinates path: the lookup can answer while
      // leaflet.js is still downloading, before PageBU has defined the boot.
      function boot(lat, lng) {
        if (window.__floristBUInitMap) window.__floristBUInitMap(lat, lng, label);
        else window.__floristBUPending = [lat, lng, label];
      }
      try {
        var q = encodeURIComponent(String(address).replace(/\n/g, ', '));
        fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + q, { headers: { 'Accept-Language': 'en' } })
          .then(function (r) { return r.ok ? r.json() : []; })
          .then(function (res) {
            if (!Array.isArray(res) || !res.length) return;
            var la = parseFloat(res[0].lat), ln = parseFloat(res[0].lon);
            if (isNaN(la) || isNaN(ln)) return;
            boot(la, ln);
          })
          .catch(function () { /* keep the drawn face */ });
      } catch (e) { /* never block render */ }
    })();
  </script>
)}
<style>
  .visit { padding: clamp(56px,7vw,112px) 0; background-color: var(--night); color: var(--cream); }
  .v-grid { display: flex; flex-wrap: wrap; align-items: stretch; gap: 40px clamp(40px,6vw,88px); }
  .v-copy { flex: 1 1 340px; min-width: 0; }
  .v-grid--solo .v-copy { max-width: 760px; }
  .v-copy > :first-child { margin-top: 0; }
  /* :global() because Astro cannot scope markup that arrived through set:html. */
  .v-h2 :global(em), .v-h2 :global(i) { font-style: normal; color: var(--accent-light); }

  .v-dl { margin: 28px 0 0; }
  .v-row { padding: 14px 0; border-top: 1px solid rgba(var(--cream-rgb),.14); }
  .v-row:last-child { border-bottom: 1px solid rgba(var(--cream-rgb),.14); }
  .v-row dt {
    font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
    color: var(--sage);
  }
  /* pre-line: an address typed on several lines keeps its breaks, and the
     editor's live update (raw text) renders the same way. */
  .v-row dd { margin: 4px 0 0; color: var(--cream); white-space: pre-line; }
  .v-row a { color: var(--cream); }
  .v-row a:hover { color: var(--accent-light); }
  .v-dir { margin-top: 20px; }

  .v-map { flex: 1.3 1 420px; min-width: 0; }
  .v-mapbox {
    position: relative; z-index: 0;
    height: 100%; min-height: 360px; overflow: hidden;
    background-color: var(--night-2);
  }
  /* The drawn fallback: a faint cream street grid and the design's pin. */
  .v-face {
    position: absolute; inset: 0;
    background-color: var(--night-2);
    background-image:
      repeating-linear-gradient(0deg, rgba(var(--cream-rgb),.05) 0 1px, transparent 1px 44px),
      repeating-linear-gradient(90deg, rgba(var(--cream-rgb),.05) 0 1px, transparent 1px 44px);
  }
  .v-pin {
    position: absolute; left: 50%; top: 50%;
    width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%;
    background-color: var(--accent-light);
    box-shadow: 0 0 0 5px rgba(var(--accent-rgb),.25);
  }
</style>
