---
/**
 * florist / FooterBT — Gumamela's INK footer: the paper wordmark and blurb,
 * then marigold-labelled columns (contact rows, page links, social links) and
 * a hairline colophon row. Plus the floating red message pill — drawn ONLY for
 * a chat channel the owner actually gave.
 *
 * Editable hooks:
 *   footer.brand · footer.blurb
 *   footer.visit.title · contact.address · contact.phone · contact.email
 *     (tel:/mailto: anchors carry data-field only — their hrefs are derived)
 *   footer.explore.title · footer.explore.links.${i}.text + .href
 *   footer.social.${i}.platform + .url
 *   footer.notes.${i}
 *   hero.cta1.text — the message pill's label
 *
 * "Follow" is template chrome (the design prints it literally), shown only
 * above real social links. The two other column headings are bound, and an
 * empty value removes the heading, not the column.
 *
 * The links column falls back to the nav list (display only, no index hooks —
 * those rows are not the footer's own array) when the owner set none.
 *
 * THE MESSAGE PILL. The gate is a real chat CHANNEL: layout.contact.whatsapp
 * (wa.me/<digits>) or layout.contact.messenger (m.me/…) — never the CTA
 * label or href (the builder gives every site a hero CTA), and never the
 * builder's messaging.* keys (derived from any phone number). The label is the
 * hero's primary CTA text. The pill's href IS the channel, so it carries no
 * data-href-field. It is a sibling AFTER the footer and carries no .btn class,
 * so the engine's `footer .btn` pin cannot reach it.
 *
 * BUTTON POLICY: no .btn inside this footer; its links are plain text links.
 * Every column and row auto-hides when empty. Never visibility-gated.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const PAGE_ANCHORS = new Set(['main', 'top', 'marquee', 'services', 'events', 'about', 'why', 'gallery', 'how', 'reviews', 'credentials', 'area', 'faq', 'visit', 'book']);
const ANCHOR_ALIAS: Record<string, string> = { work: 'gallery', contact: 'visit' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const id = href.slice(1);
  if (PAGE_ANCHORS.has(id)) return href;
  const alias = ANCHOR_ALIAS[id];
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const c = (content as any) || {};
const f = c.footer || {};
const str = (v: any): string => (typeof v === 'string' ? v : v == null ? '' : String(v));
const brand = str(f.brand || layout.businessName).trim();
const blurb = str(f.blurb || f.brand_blurb).trim();

const visitTitle = str(f.visit?.title).trim();
const address = str(layout.contact?.address || c.contact?.address).trim();
const phone = str(layout.contact?.phone || c.contact?.phone).trim();
const telHref = phone ? `tel:${phone.replace(/[^0-9+]/g, '')}` : '';
const email = str(layout.contact?.email || c.contact?.email).trim();
const hasContact = Boolean(address || phone || email);

const exploreTitle = str(f.explore?.title).trim();
const exploreFromAdmin = Array.isArray(f.explore?.links) && f.explore.links.length > 0;
const exploreSrc: any[] = exploreFromAdmin
  ? f.explore.links
  : (Array.isArray(layout.navLinks) ? layout.navLinks.map((l: any) => ({ text: l?.label, href: l?.href })) : []);
const explore = exploreSrc
  .map((l: any, i: number) => ({
    text: str(l?.text).trim(),
    href: onPage(l?.href, ''),
    textHook: exploreFromAdmin ? `footer.explore.links.${i}.text` : undefined,
    hrefHook: exploreFromAdmin ? `footer.explore.links.${i}.href` : undefined,
  }))
  .filter((l) => l.text && l.href);

const socialSrc: any[] = Array.isArray(f.social) && f.social.length
  ? f.social
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks : []);
const social = socialSrc
  .map((s: any, i: number) => ({ platform: str(s?.platform).trim(), url: str(s?.url).trim(), i }))
  .filter((s) => s.platform && s.url);

const notes = (Array.isArray(f.notes) ? f.notes : [])
  .map((n: any, i: number) => ({ v: str(n).trim(), i }))
  .filter((n: { v: string }) => n.v);

const hasBrandCol = Boolean(brand || blurb);
const hasCols = hasBrandCol || hasContact || explore.length > 0 || social.length > 0;

// Floating message pill — the channel is the gate (see the note above).
const waDigits = str(layout.contact?.whatsapp).replace(/[^0-9]/g, '');
const messenger = str(layout.contact?.messenger).trim();
// A messenger value may arrive as a full URL, a bare host path (m.me/…,
// messenger.com/…, facebook.com/…) or just the page name.
const msgHref = waDigits
  ? `https://wa.me/${waDigits}`
  : messenger
    ? (/^https?:/i.test(messenger)
        ? messenger
        : /^(www\.)?(m\.me|messenger\.com|facebook\.com|fb\.com)\//i.test(messenger)
          ? `https://${messenger}`
          : `https://m.me/${messenger.replace(/^@/, '')}`)
    : '';
const msgText = msgHref ? str(c.hero?.cta1?.text).trim() : '';
---
<footer class="gm-foot">
  <div class="wrap">
    {hasCols && (
      <div class="ft-grid">
        {hasBrandCol && (
          <div class="ft-col">
            {brand && <span class="ft-brand" data-field="footer.brand">{brand}</span>}
            {blurb && <p class="ft-blurb" data-field="footer.blurb">{blurb}</p>}
          </div>
        )}
        {hasContact && (
          <div class="ft-col">
            {visitTitle && <h3 class="ft-h" data-field="footer.visit.title">{visitTitle}</h3>}
            {address && <p class="ft-line" data-field="contact.address">{address}</p>}
            {phone && <p class="ft-line"><a class="ft-link" href={telHref} data-field="contact.phone">{phone}</a></p>}
            {email && <p class="ft-line"><a class="ft-link" href={`mailto:${email}`} data-field="contact.email">{email}</a></p>}
          </div>
        )}
        {explore.length > 0 && (
          <div class="ft-col">
            {exploreTitle && <h3 class="ft-h" data-field="footer.explore.title">{exploreTitle}</h3>}
            <div class="ft-links">
              {explore.map((l) => (
                <a class="ft-link" href={l.href} data-field={l.textHook} data-href-field={l.hrefHook}>{l.text}</a>
              ))}
            </div>
          </div>
        )}
        {social.length > 0 && (
          <div class="ft-col">
            <h3 class="ft-h">Follow</h3>
            <div class="ft-links">
              {social.map((s) => (
                <a class="ft-link" href={s.url} target="_blank" rel="noopener noreferrer" data-field={`footer.social.${s.i}.platform`} data-href-field={`footer.social.${s.i}.url`}>{s.platform}</a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
    {notes.length > 0 && (
      <div class:list={['ft-notes', !hasCols && 'ft-notes--top']}>
        {notes.map((n: { v: string; i: number }) => <span data-field={`footer.notes.${n.i}`}>{n.v}</span>)}
      </div>
    )}
  </div>
</footer>
{msgHref && msgText && (
  <a class="gm-fab" href={msgHref} target="_blank" rel="noopener noreferrer" data-field="hero.cta1.text">{msgText}</a>
)}
<style>
  .gm-foot {
    background-color: var(--ink); color: rgba(var(--paper-rgb),.78);
    padding: clamp(48px,6vw,80px) 0 clamp(96px,10vw,120px);
  }
  .ft-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,200px), 1fr)); gap: 32px;
  }
  .ft-col { min-width: 0; }
  .ft-brand {
    font-family: var(--disp); font-weight: 800; font-size: 34px; line-height: 1.6;
    letter-spacing: -.04em; color: var(--paper); overflow-wrap: anywhere;
  }
  .ft-blurb { margin: 12px 0 0; max-width: 34ch; font-size: 15px; line-height: 1.6; }
  .ft-blurb:first-child { margin-top: 0; }
  .ft-h {
    margin: 0 0 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; line-height: 1.6;
    letter-spacing: .14em; text-transform: uppercase; color: var(--accent-light);
  }
  .ft-line { margin: 0 0 6px; font-size: 15px; line-height: 1.6; overflow-wrap: anywhere; }
  .ft-line:last-child { margin-bottom: 0; }
  /* Default stretch, as drawn: each link spans its column (the hover and the
     click target are the whole row, not just the word). */
  .ft-links { display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.6; }
  .ft-link { color: inherit; overflow-wrap: anywhere; }
  .ft-link:hover { color: var(--paper); }
  .ft-notes {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: 40px; padding-top: 20px; border-top: 1px solid rgba(var(--paper-rgb),.18);
    font-size: 13px; line-height: 1.6; color: rgba(var(--paper-rgb),.62);
  }
  .ft-notes--top { margin-top: 0; }
  .ft-notes span { overflow-wrap: anywhere; min-width: 0; }

  /* The floating pill: the design's red slab with an ink rim and a hard ink
     shadow; hover fills it ink with a paper label. */
  .gm-fab {
    position: fixed; right: clamp(12px,2vw,24px); bottom: clamp(12px,2vw,24px); z-index: 60;
    display: inline-flex; align-items: center; min-height: 54px; padding: 0 22px;
    border-radius: 14px; background-color: var(--accent); border: 2px solid var(--ink);
    color: var(--on-primary); font-family: var(--sans); font-size: 15px; font-weight: 700; line-height: 1.6;
    white-space: nowrap; box-shadow: 4px 4px 0 var(--ink);
    max-width: calc(100vw - 32px); overflow: hidden; text-overflow: ellipsis;
  }
  .gm-fab:hover { background-color: var(--ink); color: var(--paper); }
</style>
