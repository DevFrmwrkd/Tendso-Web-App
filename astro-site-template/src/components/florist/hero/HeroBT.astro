---
/**
 * florist / HeroBT — Gumamela's opener (#top): a marigold kicker pill, an
 * enormous Bricolage 800 headline whose emphasised phrase prints in red, the
 * sub-line beside two buttons, then a photo row — the big lead photo, and a
 * side column holding a second photo over an ink card with a marigold figure.
 *
 * Editable hooks:
 *   hero.kicker · hero.headline (set:html: an owner's <em>…</em> is the red
 *   phrase) OR hero.headlineLines.${i} (see THE HEADLINE) · hero.sub ·
 *   hero.cta1.text + hero.cta1.href · hero.cta2.text + hero.cta2.href ·
 *   data-image-field hero.image · data-image-field services.items.1.image (the
 *   second photo, shown AGAIN here on purpose, as the handoff specifies — the
 *   same field as the second shop card) · hero.meta1 · hero.meta2
 *
 * THE HEADLINE (HeroBS's rule). The AI copy writer fills hero.headlineLines —
 * never hero.headline — and the derive layer fills hero.headline with the
 * business name on every build. So when lines exist and hero.headline is blank
 * or is still just the business name, the one h1 prints the LINES inline, each
 * row a set:html span bound to hero.headlineLines.${i} (ORIGINAL index), so an
 * inline edit writes the row it touches. A headline the owner wrote wins.
 *
 * THE RED PHRASE IS THE OWNER'S. The design colours "every kind of day." with
 * an inline span; here the headline (or each line) is printed with set:html
 * and any <em> or <i> inside it takes the red (the editor's own hint tells
 * owners to wrap a phrase in <em>, and the AI marks its highlight the same
 * way). Nothing is derived from the sentence: a headline with no <em> is all
 * ink.
 *
 * THE INK CARD is the meta pair. hero.meta1 is its figure and opens the card;
 * hero.meta2 is the line that finishes meta1's sentence and only prints beside
 * it — on its own it is half a sentence (the builder also fills meta2 with the
 * bare city on every first build, which would ship a dark card saying only a
 * place name). Same rule as a unit printed only beside its price.
 *
 * NO PHOTO, NO FRAME. The row adapts instead of reserving blush rectangles:
 *   · lead + side photo + card  → the design, exactly
 *   · lead + card               → the card grows to fill the side column and
 *                                 sets its figure at the bottom, like a poster
 *   · lead alone                → one full-width photo
 *   · side photo, no lead       → the side photo takes the lead frame (its hook
 *                                 is still services.items.1.image)
 *   · card alone                → the card alone, at the side column's width
 *   · nothing                   → no row; the typographic hero stands alone
 *
 * CLASS-NAME LAW: the section is .gm-top, never .hero (buildOverrideCss paints
 * `.hero .btn-ghost` white with !important). Buttons are .btn--fill/.btn--line.
 */
interface Props { content: any; layout?: any; }
const { content, layout } = Astro.props;
// Anchor guard — identical copy in HeaderBT / ServicesBT / CtaBandBT / FooterBT.
const PAGE_ANCHORS = new Set(['main', 'top', 'marquee', 'services', 'events', 'about', 'why', 'gallery', 'how', 'reviews', 'credentials', 'area', 'faq', 'visit', 'book']);
const ANCHOR_ALIAS: Record<string, string> = { work: 'gallery', contact: 'visit' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const id = href.slice(1);
  if (PAGE_ANCHORS.has(id)) return href;
  const alias = ANCHOR_ALIAS[id];
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const hero = content.hero || {};
const str = (v: any): string => (typeof v === 'string' ? v : v == null ? '' : String(v));
const kicker = str(hero.kicker).trim();
// THE HEADLINE — see the doc comment. Rows keep their ORIGINAL index.
const bizName = str(layout?.businessName).trim();
const headline = str(hero.headline).trim();
const lineRows: Array<{ text: string; i: number }> = (Array.isArray(hero.headlineLines) ? hero.headlineLines : [])
  .map((t: any, i: number) => ({ text: str(t).trim(), i }))
  .filter((l: { text: string }) => l.text !== '');
const useRows = lineRows.length > 0
  && (headline === '' || headline === bizName)
  && lineRows.map((l) => l.text).join(' ') !== headline;
const hasHeadline = useRows || headline !== '';
const sub = str(hero.sub).trim();
const cta1Text = str(hero.cta1?.text).trim();
const cta1Href = onPage(hero.cta1?.href, '#book');
const cta2Text = str(hero.cta2?.text).trim();
const cta2Href = onPage(hero.cta2?.href, '#book');
const meta1 = str(hero.meta1).trim();
const meta2 = str(hero.meta2).trim();

// Photos. Display fallbacks for the lead only (the submission's own first
// photo); the HOOK is always the field the picker writes.
const svc = content.services || {};
const svcItems: any[] = Array.isArray(svc.items) ? svc.items : (Array.isArray(content.services) ? content.services : []);
const leadSrc = str(hero.image || (Array.isArray(hero.photos) && hero.photos[0]) || (Array.isArray(content.photos) && content.photos[0]) || '').trim();
const sideSrc = str(svcItems[1]?.image).trim();
const sideName = str(svcItems[1]?.title || svcItems[1]?.name).trim();
const bg = (u: string) => `background-image:url('${u.replace(/'/g, '%27').replace(/[\r\n]/g, '')}')`;
type Photo = { src: string; field: string; label: string };
const lead: Photo | null = leadSrc
  ? { src: leadSrc, field: 'hero.image', label: '' }
  : (sideSrc ? { src: sideSrc, field: 'services.items.1.image', label: sideName } : null);
const side: Photo | null = leadSrc && sideSrc ? { src: sideSrc, field: 'services.items.1.image', label: sideName } : null;
const hasCard = Boolean(meta1);
const hasMedia = Boolean(lead || side || hasCard);
// The hero speaks when it has a headline, a sub-line or something to show. The
// kicker and the buttons alone never open it (both are derived on every site).
const show = Boolean(hasHeadline || sub || hasMedia);
---
{show && (
  <section class="gm-top" id="top">
    <div class="wrap">
      {kicker && <p class="kick" data-field="hero.kicker">{kicker}</p>}
      {hasHeadline && (
        useRows ? (
          <h1 class="h1">
            {lineRows.map((l, k) => (
              <Fragment>{k > 0 && ' '}<span data-field={`hero.headlineLines.${l.i}`} set:html={l.text}></span></Fragment>
            ))}
          </h1>
        ) : (
          <h1 class="h1" data-field="hero.headline" set:html={headline}></h1>
        )
      )}
      {(sub || cta1Text || cta2Text) && (
        <div class="lede-row">
          {sub && <p class="sub" data-field="hero.sub">{sub}</p>}
          {(cta1Text || cta2Text) && (
            <div class="ctas">
              {cta1Text && <a class="btn btn--fill" href={cta1Href} data-field="hero.cta1.text" data-href-field="hero.cta1.href">{cta1Text}</a>}
              {cta2Text && <a class="btn btn--line" href={cta2Href} data-field="hero.cta2.text" data-href-field="hero.cta2.href">{cta2Text}</a>}
            </div>
          )}
        </div>
      )}
      {hasMedia && (
        <div class="media">
          {lead && (
            <div
              class="ph lead"
              data-image-field={lead.field}
              role={lead.label ? 'img' : undefined}
              aria-label={lead.label || undefined}
              aria-hidden={lead.label ? undefined : 'true'}
              style={bg(lead.src)}
            ></div>
          )}
          {(side || hasCard) && (
            <div class:list={['col', !lead && 'col--solo']}>
              {side && (
                <div
                  class="ph side"
                  data-image-field={side.field}
                  role={side.label ? 'img' : undefined}
                  aria-label={side.label || undefined}
                  aria-hidden={side.label ? undefined : 'true'}
                  style={bg(side.src)}
                ></div>
              )}
              {hasCard && (
                <div class:list={['card', lead && !side && 'card--tall']}>
                  <b class="m1" data-field="hero.meta1">{meta1}</b>
                  {meta2 && <span class="m2" data-field="hero.meta2">{meta2}</span>}
                </div>
              )}
            </div>
          )}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .gm-top { padding: clamp(32px,5vw,64px) 0 clamp(48px,6vw,80px); }

  .kick {
    display: inline-flex; margin: 0; padding: 6px 14px; border-radius: 999px;
    background-color: var(--accent-light); color: var(--ink);
    font-family: var(--sans); font-size: 13px; font-weight: 700; line-height: 1.6;
    letter-spacing: .04em; text-transform: none; max-width: 100%; overflow-wrap: anywhere;
  }
  .h1 {
    margin: 20px 0 0; max-width: 15ch;
    font-family: var(--disp); font-weight: 800; color: var(--ink);
    font-size: clamp(46px,8.6vw,132px); line-height: .92; letter-spacing: -.045em;
    text-wrap: balance; overflow-wrap: break-word;
  }
  .h1:first-child { margin-top: 0; }
  /* The design's signature: the owner's emphasised phrase in red, upright.
     :global() because Astro cannot scope markup that arrived via set:html. */
  .h1 :global(em), .h1 :global(i) { font-style: normal; color: var(--accent-text); }

  .lede-row {
    display: flex; flex-wrap: wrap; gap: 24px clamp(24px,5vw,72px);
    align-items: flex-end; margin-top: clamp(24px,3vw,40px);
  }
  .lede-row:first-child { margin-top: 0; }
  .sub {
    flex: 1 1 360px; min-width: 0; max-width: 48ch; margin: 0;
    font-size: clamp(16px,1.4vw,19px); line-height: 1.6; color: var(--ink-soft);
    text-wrap: pretty;
  }
  .ctas { flex: 0 1 auto; display: flex; flex-wrap: wrap; gap: 12px; min-width: 0; }
  .ctas .btn { max-width: 100%; }

  .media {
    display: flex; flex-wrap: wrap; gap: clamp(12px,1.6vw,20px);
    margin-top: clamp(32px,4vw,52px);
  }
  .media:first-child { margin-top: 0; }
  .lead {
    flex: 2 1 420px; min-width: 0; aspect-ratio: 16/10; border-radius: 28px;
    position: relative;
  }
  .col {
    flex: 1 1 260px; min-width: 0;
    display: flex; flex-direction: column; gap: clamp(12px,1.6vw,20px);
  }
  /* No lead photo: the card keeps the side column's width instead of
     stretching into a full-width slab. */
  .col--solo { flex: 0 1 460px; }
  .side { flex: 1 1 180px; border-radius: 28px; }
  .card {
    flex: none; border-radius: 28px; padding: 22px 24px;
    background-color: var(--ink); color: var(--paper);
  }
  /* Lead photo but no side photo: the card fills the column, figure at the
     bottom, so the pair still reads as the design's two-column composition. */
  .card--tall { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: flex-end; }
  .m1 {
    display: block; font-family: var(--disp); font-weight: 800;
    font-size: clamp(28px,3vw,40px); line-height: 1; letter-spacing: -.03em;
    color: var(--accent-light); overflow-wrap: anywhere;
  }
  .m2 { display: block; margin-top: 8px; font-size: 15px; line-height: 1.6; overflow-wrap: anywhere; }
</style>
