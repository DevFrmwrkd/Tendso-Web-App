---
/**
 * florist / AboutBS — "our story": a 4:5 portrait sitting on a deeper-blush
 * block offset down-left behind it, a small white stamp pinned to its top
 * right (the owner's "Est." and year), and beside it the script eyebrow, a
 * Gilda headline, a Gilda lead in the ink, the soft body paragraphs, and a
 * Pinyon Script signature over a tracked caps role line.
 *
 * Editable hooks (all schema-owned):
 *   about.image · about.stampTag · about.stampYear · about.tag ·
 *   about.headline · about.lead · about.paragraphs.${i} (ORIGINAL index,
 *   blanks dropped) · about.signatureName · about.role
 *
 * THE SIGNATURE reads about.signatureName, falling back for DISPLAY to the
 * signature line the derive layer fills with the business name — the schema
 * declares that same fallback for the signatureName box, so the sidebar and
 * the page always show the same words. The role line only ever renders under
 * a name: a role attributed to nobody is a claim with no author.
 *
 * NO PHOTO, NO FIGURE. Without about.image the portrait column (the photo, the
 * blush block behind it) is not drawn and the story takes the full measure.
 * The stamp is owner data, not decoration, so it survives: it moves from the
 * photo's corner to the top of the story column, the same white card.
 * The stamp itself needs its YEAR — "Est." over nothing says nothing.
 *
 * SECTION GATE: a portrait, a lead, a paragraph, a signature or a stamp year.
 * The eyebrow and headline are not counted: the derive layer fills both on
 * every named site, and a heading over nothing is an empty shell.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const str = (v: any): string => String(v ?? '').trim();
const A = (content as any).about || {};
const image = str(A.image);
const tag = str(A.tag);
const headline = str(A.headline);
const lead = str(A.lead);
const paras = (Array.isArray(A.paragraphs) ? A.paragraphs : [])
  .map((t: any, i: number) => ({ text: str(t), i }))
  .filter((p: { text: string }) => p.text !== '');
const signature = str(A.signatureName) || str(A.signature);
const role = str(A.role);
const stampYear = str(A.stampYear);
const stampTag = str(A.stampTag);
const hasStamp = stampYear !== '';
const hasSection = Boolean(image || lead || signature || hasStamp) || paras.length > 0;
---
{hasSection && (
  <section class="ab" id="about">
    <div class:list={['k-wrap', 'ab-in', !image && 'ab-in--solo']}>
      {image && (
        <div class="ab-fig">
          <span class="ab-block" aria-hidden="true"></span>
          <img class="ab-img" src={image} alt="" decoding="async" data-image-field="about.image" />
          {hasStamp && (
            <div class="ab-stamp">
              {stampTag && <span class="ab-stamp-tag" data-field="about.stampTag">{stampTag}</span>}
              <span class="ab-stamp-year" data-field="about.stampYear">{stampYear}</span>
            </div>
          )}
        </div>
      )}
      <div class="ab-copy">
        {!image && hasStamp && (
          <div class="ab-stamp ab-stamp--inline">
            {stampTag && <span class="ab-stamp-tag" data-field="about.stampTag">{stampTag}</span>}
            <span class="ab-stamp-year" data-field="about.stampYear">{stampYear}</span>
          </div>
        )}
        {tag && <p class="k-tag" data-field="about.tag">{tag}</p>}
        {headline && <h2 class="ab-h2" data-field="about.headline" set:html={headline}></h2>}
        {lead && <p class="ab-lead" data-field="about.lead">{lead}</p>}
        {paras.map((p) => (
          <p class="ab-p" data-field={`about.paragraphs.${p.i}`}>{p.text}</p>
        ))}
        {signature && (
          <div class="ab-sign">
            <p class="ab-name" data-field="about.signatureName">{signature}</p>
            {role && <p class="ab-role" data-field="about.role">{role}</p>}
          </div>
        )}
      </div>
    </div>
  </section>
)}
<style>
  .ab { padding: clamp(56px, 7vw, 112px) 0; }
  .ab-in { display: flex; flex-wrap: wrap; gap: clamp(40px, 6vw, 96px); align-items: center; }

  /* The portrait column. The padding (0 0 24px 24px) is the room the blush
     block needs to show below and left of the photo. */
  .ab-fig {
    flex: 1 1 320px; min-width: 0; max-width: 480px; margin-inline: auto;
    position: relative; padding: 0 0 24px 24px;
  }
  .ab-block {
    position: absolute; left: 0; bottom: 0; width: 78%; height: 78%;
    border-radius: 22px; background-color: var(--blush);
  }
  .ab-img {
    position: relative; width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: 18px; background-color: var(--band);
  }
  .ab-stamp {
    position: absolute; right: -6px; top: 22px; padding: 14px 18px;
    border-radius: 14px; background-color: var(--sheet); text-align: center;
    box-shadow: 0 12px 26px rgba(var(--shade-rgb), .1);
  }
  /* No portrait: the same card, at the head of the story. */
  .ab-stamp--inline { position: static; display: inline-block; margin-bottom: 22px; }
  .ab-stamp-tag {
    display: block; font-size: 10.5px; font-weight: 500; letter-spacing: .24em;
    text-transform: uppercase; color: var(--ink-soft); line-height: 1.7;
  }
  .ab-stamp-year {
    display: block; font-family: var(--disp); font-size: 28px; line-height: 1.1; color: var(--rose-ink);
  }

  .ab-copy { flex: 1 1 440px; min-width: 0; }
  /* No portrait: the story is one centred column at a reading measure, not a
     left-hugging block with a hole where the photo was. */
  .ab-in--solo .ab-copy { max-width: 820px; margin-inline: auto; }
  .ab-h2 {
    margin: 6px 0 0; font-family: var(--disp); font-weight: 400;
    font-size: clamp(32px, 4.2vw, 54px); line-height: 1.1; text-wrap: balance;
    overflow-wrap: break-word;
  }
  .ab-lead {
    margin: 24px 0 0; font-family: var(--disp);
    font-size: clamp(19px, 1.8vw, 22px); line-height: 1.5; text-wrap: pretty;
  }
  .ab-p { margin: 18px 0 0; color: var(--ink-soft); text-wrap: pretty; }
  .ab-p + .ab-p { margin-top: 12px; }
  /* No lead: the first paragraph takes the lead's 24px under the headline. */
  .ab-h2 + .ab-p { margin-top: 24px; }
  .ab-sign { margin-top: 26px; }
  .ab-name {
    margin: 0; font-family: var(--script); font-size: 38px; line-height: 1.1; color: var(--ink);
    overflow-wrap: break-word;
  }
  .ab-role {
    margin: 4px 0 0; font-size: 12px; font-weight: 500; letter-spacing: .18em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  /* Whatever opens the story column sits flush at its top. */
  .ab-copy > :first-child { margin-top: 0; }
</style>
