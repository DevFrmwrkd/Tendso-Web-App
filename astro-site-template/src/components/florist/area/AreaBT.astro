---
/**
 * florist / AreaBT — Gumamela's delivery area (#area): red eyebrow, a big
 * Bricolage headline, a muted paragraph, then the places as solid ink tiles.
 *
 * Editable hooks: area.tag · area.headline (set:html; an <em> prints upright
 * in the hero's red) · area.body · area.places.${i} (ORIGINAL index).
 *
 * THE GATE (HospitalityBJ's rule, do not relax it): the builder derives
 * area.places as [the owner's city] and a headline from it on essentially every
 * site, so counting either would ship this band on every build as the address
 * again. It renders only when the owner named a SECOND place or wrote the
 * paragraph — either can only have come from a person.
 *
 * The design tints its last tile blush to mark a next-day zone. Which places are
 * next-day is the owner's knowledge, not the list's position, so every tile
 * takes the same ink treatment; nothing about a place is implied by its order.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const area = content.area || {};
const str = (v: any): string => (typeof v === 'string' ? v : v == null ? '' : String(v));
const tag = str(area.tag).trim();
const headline = str(area.headline).trim();
const body = str(area.body).trim();
const places: any[] = Array.isArray(area.places) ? area.places : [];
const rows = places.map((p: any, i: number) => ({ v: str(p).trim(), i })).filter((r) => r.v);
const show = rows.length >= 2 || Boolean(body);
---
{show && (
  <section class="gm-area" id="area">
    <div class="wrap">
      {tag && <p class="eyebrow" data-field="area.tag">{tag}</p>}
      {headline && <h2 class="ar-h" data-field="area.headline" set:html={headline}></h2>}
      {body && <p class="ar-b" data-field="area.body">{body}</p>}
      {rows.length > 0 && (
        <div class="ar-places">
          {rows.map((r) => <span class="ar-place" data-field={`area.places.${r.i}`}>{r.v}</span>)}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .gm-area { padding: clamp(56px,7vw,104px) 0; }
  .ar-h {
    margin: 12px 0 0; font-family: var(--disp); font-weight: 800; color: var(--ink);
    font-size: clamp(34px,5vw,68px); line-height: .98; letter-spacing: -.04em;
    text-wrap: balance; overflow-wrap: break-word;
  }
  /* :global() because Astro cannot scope markup that arrived via set:html. */
  .ar-h :global(em), .ar-h :global(i) { font-style: normal; color: var(--accent-text); }
  .ar-b { margin: 16px 0 28px; max-width: 52ch; line-height: 1.6; color: var(--ink-soft); }
  .ar-b:last-child { margin-bottom: 0; }
  .ar-h + .ar-places { margin-top: 28px; }
  .eyebrow + .ar-places { margin-top: 16px; }
  .gm-area .wrap > :first-child { margin-top: 0; }
  .ar-places { display: flex; flex-wrap: wrap; gap: 10px; }
  .ar-place {
    padding: 12px 20px; border-radius: 14px;
    background-color: var(--ink); color: var(--paper);
    font-size: 15.5px; font-weight: 600; line-height: 1.6; max-width: 100%; overflow-wrap: anywhere;
  }
</style>
