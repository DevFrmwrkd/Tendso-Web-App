---
/**
 * florist / ServicesBT — Gumamela's shop (#services) AND the weddings & events
 * band (#events) directly under it.
 *
 *   #services  the paper section: red eyebrow, big Bricolage headline with the
 *              owner's sub-paragraph beside it, then white cards ruled in 2px
 *              ink — a square photo, a marigold tag pill, the name, a line.
 *   #events    the full-bleed INK band: marigold eyebrow, paper headline and
 *              body, a marigold button, and two staggered 3:4 photos.
 *
 * WHY THE BAND LIVES HERE. It binds services.whole.* and services.ctaLabel /
 * services.ctaHref, so it belongs to the Services block. Both full-bleed
 * sections sit inside ONE element marked data-block="services": the editor's
 * Blocks toggle hides the element carrying that marker, and without the
 * wrapper it would hide only one of the two.
 *
 * Editable hooks:
 *   services.tag · services.headline (set:html) · services.sub
 *   services.items.${i}.image (img) · .tag OR .note · .title · .desc
 *                                                          (ORIGINAL index)
 *   services.whole.tag · services.whole.headline (set:html) · services.whole.body
 *   services.ctaLabel + data-href-field services.ctaHref      (band button)
 *   gallery.items.0.image · gallery.items.2.image (img)       (band photos —
 *     the gallery's first and third photos shown AGAIN here on purpose, as the
 *     handoff specifies; the same fields the gallery binds)
 *
 * GATES. The shop section renders only with at least one filled card — its
 * eyebrow and headline are derived on every site and a heading over nothing is
 * an empty shell. The band renders only with a headline or a body; its eyebrow
 * or button alone never opens it. A card with no photo draws no photo frame.
 *
 * THE PILL is the row's tag; with no tag it shows the row's note (the AI copy
 * writer fills note — "same-day", "by appointment" — never tag). It binds the
 * path its value came from, so an inline edit writes the field on show.
 *
 * HEADLINES are set:html (the AI and the editor mark a highlight with <em>):
 * the emphasis prints upright in the page's red on paper and in marigold on
 * the ink band.
 *
 * Anchor guard: identical copy in HeaderBT / HeroBT / CtaBandBT / FooterBT.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const PAGE_ANCHORS = new Set(['main', 'top', 'marquee', 'services', 'events', 'about', 'why', 'gallery', 'how', 'reviews', 'credentials', 'area', 'faq', 'visit', 'book']);
const ANCHOR_ALIAS: Record<string, string> = { work: 'gallery', contact: 'visit' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const id = href.slice(1);
  if (PAGE_ANCHORS.has(id)) return href;
  const alias = ANCHOR_ALIAS[id];
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const str = (v: any): string => (typeof v === 'string' ? v : v == null ? '' : String(v));
const bg = (u: string) => `background-image:url('${u.replace(/'/g, '%27').replace(/[\r\n]/g, '')}')`;

const services = content.services || {};
const tag = str(services.tag).trim();
const headline = str(services.headline).trim();
const sub = str(services.sub).trim();
// Both shapes: the wrapped {items[]} and the legacy bare array, with the legacy
// name/description vocabulary read as title/desc.
const rawItems: any[] = Array.isArray(services.items) ? services.items : (Array.isArray(content.services) ? content.services : []);
const rows = rawItems
  .map((it: any, i: number) => {
    const tagV = str(it?.tag).trim();
    const noteV = str(it?.note).trim();
    return {
      title: str(it?.title ?? it?.name).trim(),
      desc: str(it?.desc ?? it?.description).trim(),
      // The pill: tag first, else note — bound to whichever it came from.
      tag: tagV || noteV,
      tagField: tagV ? 'tag' : 'note',
      image: str(it?.image).trim(),
      i,
    };
  })
  .filter((r) => Boolean(r.title || r.desc || r.tag || r.image));

const whole = services.whole || {};
const wTag = str(whole.tag).trim();
const wHeadline = str(whole.headline).trim();
const wBody = str(whole.body).trim();
const ctaLabel = str(services.ctaLabel).trim();
// With no href of its own the band's button takes the page's one contact
// action, so it is never pointed at nothing; the HOOK stays services.ctaHref.
const ctaHref = onPage(services.ctaHref, onPage(content.hero?.cta1?.href, '#book'));
// The band's two photos: gallery rows 0 and 2, by their ORIGINAL index.
const gItems: any[] = Array.isArray(content.gallery?.items) ? content.gallery.items : [];
const bandPhotos = [0, 2]
  .map((i) => ({ src: str(gItems[i]?.image).trim(), caption: str(gItems[i]?.caption).trim(), i }))
  .filter((p) => Boolean(p.src));

const hasGrid = rows.length > 0;
const hasBand = Boolean(wHeadline || wBody);
---
{(hasGrid || hasBand) && (
  <div class="gm-svc" data-block="services">
    {hasGrid && (
      <section class="gm-shop" id="services">
        <div class="wrap">
          {(tag || headline || sub) && (
            <div class="head">
              {(tag || headline) && (
                <div class="head-l">
                  {tag && <p class="eyebrow" data-field="services.tag">{tag}</p>}
                  {headline && <h2 class="h2" data-field="services.headline" set:html={headline}></h2>}
                </div>
              )}
              {sub && <p class="head-sub" data-field="services.sub">{sub}</p>}
            </div>
          )}
          <div class:list={['grid', rows.length <= 2 && 'grid--few']}>
            {rows.map((it) => (
              <article class="item">
                {it.image && (
                  <div
                    class="ph item-ph"
                    data-image-field={`services.items.${it.i}.image`}
                    role={it.title ? 'img' : undefined}
                    aria-label={it.title || undefined}
                    aria-hidden={it.title ? undefined : 'true'}
                    style={bg(it.image)}
                  ></div>
                )}
                {(it.tag || it.title || it.desc) && (
                  <div class="item-body">
                    {it.tag && (it.tagField === 'tag'
                      ? <span class="item-tag" data-field={`services.items.${it.i}.tag`}>{it.tag}</span>
                      : <span class="item-tag" data-field={`services.items.${it.i}.note`}>{it.tag}</span>)}
                    {it.title && <h3 class="item-t" data-field={`services.items.${it.i}.title`}>{it.title}</h3>}
                    {it.desc && <p class="item-d" data-field={`services.items.${it.i}.desc`}>{it.desc}</p>}
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
    {hasBand && (
      <section class="gm-events" id="events">
        <div class="wrap ev-in">
          <div class="ev-copy">
            {wTag && <p class="eyebrow ev-tag" data-field="services.whole.tag">{wTag}</p>}
            {wHeadline && <h2 class="ev-h" data-field="services.whole.headline" set:html={wHeadline}></h2>}
            {wBody && <p class="ev-body" data-field="services.whole.body">{wBody}</p>}
            {ctaLabel && <a class="btn btn--mari ev-cta" href={ctaHref} data-field="services.ctaLabel" data-href-field="services.ctaHref">{ctaLabel}</a>}
          </div>
          {bandPhotos.length > 0 && (
            <div class:list={['ev-pics', bandPhotos.length === 1 && 'ev-pics--one']}>
              {bandPhotos.map((p, k) => (
                <div
                  class:list={['ph', 'ev-ph', k === 1 && 'ev-ph--low']}
                  data-image-field={`gallery.items.${p.i}.image`}
                  role={p.caption ? 'img' : undefined}
                  aria-label={p.caption || undefined}
                  aria-hidden={p.caption ? undefined : 'true'}
                  style={bg(p.src)}
                ></div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}
  </div>
)}
<style>
  /* ── #services ─────────────────────────────────────────────────────── */
  .gm-shop { padding: clamp(56px,7vw,104px) 0; }
  .head {
    display: flex; flex-wrap: wrap; gap: 16px 56px; align-items: flex-end;
    margin-bottom: clamp(32px,4vw,52px);
  }
  .head-l { flex: 1 1 440px; min-width: 0; }
  .h2 {
    margin: 12px 0 0; font-family: var(--disp); font-weight: 800; color: var(--ink);
    font-size: clamp(36px,5.4vw,76px); line-height: .96; letter-spacing: -.04em;
    text-wrap: balance; overflow-wrap: break-word;
  }
  .h2:first-child { margin-top: 0; }
  /* The highlight, upright in red (the hero's treatment). :global() because
     Astro cannot scope markup that arrived via set:html. */
  .h2 :global(em), .h2 :global(i) { font-style: normal; color: var(--accent-text); }
  .head-sub {
    flex: 1 1 300px; min-width: 0; max-width: 42ch; margin: 0;
    line-height: 1.6; color: var(--ink-soft); text-wrap: pretty;
  }

  /* The design's auto-fit: three or more cards share the row. */
  .grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,270px), 1fr));
    gap: clamp(14px,2vw,24px);
  }
  /* One or two cards: auto-FILL keeps them at card width, so a lone square
     photo never swells to half or all of the row. */
  .grid--few { grid-template-columns: repeat(auto-fill, minmax(min(100%,270px), 1fr)); }
  .item {
    display: flex; flex-direction: column; min-width: 0;
    border-radius: 28px; background-color: var(--card);
    border: 2px solid var(--ink); overflow: hidden;
  }
  .item-ph { aspect-ratio: 1/1; border-bottom: 2px solid var(--ink); }
  .item-body { padding: 22px 22px 26px; }
  .item-tag {
    display: inline-flex; padding: 4px 10px; border-radius: 999px;
    background-color: var(--accent-light); color: var(--ink);
    font-size: 12px; font-weight: 700; line-height: 1.6; max-width: 100%; overflow-wrap: anywhere;
  }
  .item-t {
    margin: 12px 0 6px; font-family: var(--disp); font-weight: 800; color: var(--ink);
    font-size: clamp(24px,2.4vw,30px); line-height: 1.05; letter-spacing: -.03em;
    overflow-wrap: break-word;
  }
  .item-t:first-child { margin-top: 0; }
  .item-t:last-child { margin-bottom: 0; }
  .item-d { margin: 0; font-size: 15.5px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }

  /* ── #events · the ink band ────────────────────────────────────────── */
  .gm-events {
    padding: clamp(56px,7vw,104px) 0;
    background-color: var(--ink); color: var(--paper);
  }
  .ev-in {
    display: flex; flex-wrap: wrap; gap: clamp(32px,5vw,72px); align-items: center;
  }
  .ev-copy { flex: 1 1 420px; min-width: 0; }
  .ev-tag { color: var(--accent-light); }
  .ev-h {
    margin: 12px 0 0; font-family: var(--disp); font-weight: 800; color: var(--paper);
    font-size: clamp(34px,5vw,68px); line-height: .98; letter-spacing: -.04em;
    text-wrap: balance; overflow-wrap: break-word;
  }
  .ev-h:first-child { margin-top: 0; }
  /* On the ink band the highlight takes the band's marigold (its eyebrow's
     colour); the red would sink into the ink. */
  .ev-h :global(em), .ev-h :global(i) { font-style: normal; color: var(--accent-light); }
  .ev-body {
    margin: 20px 0 30px; max-width: 48ch; line-height: 1.6;
    color: rgba(var(--paper-rgb),.82); text-wrap: pretty;
  }
  .ev-body:first-child { margin-top: 0; }
  .ev-body:last-child { margin-bottom: 0; }
  .ev-h + .ev-cta { margin-top: 30px; }
  .ev-tag + .ev-cta { margin-top: 20px; }
  .ev-pics { flex: 1 1 380px; min-width: 0; display: flex; gap: clamp(12px,1.6vw,20px); }
  .ev-ph { flex: 1 1 0; min-width: 0; aspect-ratio: 3/4; border-radius: 28px; background-color: rgba(var(--paper-rgb),.14); }
  .ev-ph--low { margin-top: clamp(24px,5vw,64px); }
  /* One photo keeps the pair's scale instead of swelling to the whole column. */
  .ev-pics--one .ev-ph { flex: 0 1 calc(50% - clamp(12px,1.6vw,20px) / 2); }
</style>
