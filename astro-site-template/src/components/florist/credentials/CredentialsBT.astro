---
/**
 * florist / CredentialsBT — Gumamela's "on record" strip (#credentials): a
 * band ruled top and bottom in 2px ink, a short display-face label on the left
 * and the owner's credentials as outlined ink pills beside it.
 *
 * Editable hooks: credentials.tag · credentials.items.${i}.title (ORIGINAL
 * index). The design draws a pill per item with its title only.
 *
 * NEVER FABRICATED. Nothing derives credentials: with no titled row the strip
 * is absent, and the label never renders over no pills. No seal, tick or badge
 * glyph is drawn — a drawn badge is a certification claim of its own.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const str = (v: any): string => (typeof v === 'string' ? v : v == null ? '' : String(v));
const tag = str(cred.tag).trim();
const items: any[] = Array.isArray(cred.items) ? cred.items : (Array.isArray(content.credentials) ? content.credentials : []);
const rows = items
  .map((it: any, i: number) => ({ title: str(it?.title ?? it?.label).trim(), i }))
  .filter((r) => Boolean(r.title));
---
{rows.length > 0 && (
  <section class="gm-cred" id="credentials">
    <div class="wrap cr-in">
      {tag && <p class="cr-tag" data-field="credentials.tag">{tag}</p>}
      <div class="cr-pills">
        {rows.map((r) => (
          <span class="cr-pill" data-field={`credentials.items.${r.i}.title`}>{r.title}</span>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gm-cred {
    padding: clamp(36px,5vw,56px) 0;
    border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
  }
  .cr-in { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; }
  .cr-tag {
    flex: none; max-width: 100%; margin: 0;
    font-family: var(--disp); font-weight: 800; font-size: 20px; line-height: 1.6;
    letter-spacing: -.02em; color: var(--ink); overflow-wrap: anywhere;
  }
  .cr-pills { flex: 1 1 480px; min-width: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .cr-pill {
    padding: 10px 16px; border-radius: 999px; border: 2px solid var(--ink);
    background-color: transparent; color: var(--ink);
    font-size: 14.5px; font-weight: 600; line-height: 1.6; max-width: 100%; overflow-wrap: anywhere;
  }
</style>
