---
/**
 * florist / CredentialsBU — the proof strip (#credentials): a quiet grid of
 * small Gloock titles over sage detail lines. The design gives this section no
 * eyebrow and no headline, so none is rendered.
 *
 * Editable hooks: credentials.items.${r.i}.title · credentials.items.${r.i}.body
 * (ORIGINAL index, blank rows dropped; legacy label/detail/desc read too, the
 * canonical keys spelled in the hooks).
 *
 * NEVER FABRICATED: accreditations, insurance, registrations and payment
 * methods are claims only the owner may make; the section exists only for
 * rows they typed (astro-builder also turns the block off when there are
 * none).
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const str = (v: any): string => (v === null || v === undefined ? '' : String(v).trim());
const cred = content.credentials || {};
const items: any[] = Array.isArray(cred.items) ? cred.items : (Array.isArray(cred) ? cred : []);
const rows = items
  .map((it: any, i: number) => ({
    title: str(it?.title ?? it?.label),
    body: str(it?.body ?? it?.desc ?? it?.detail ?? it?.description),
    i,
  }))
  .filter((r) => r.title || r.body);
---
{rows.length > 0 && (
  <section id="credentials" class="cred">
    <div class="wrap c-grid">
      {rows.map((r) => (
        <div class="c-item">
          {r.title && <h3 class="c-h3" data-field={`credentials.items.${r.i}.title`}>{r.title}</h3>}
          {r.body && <p class="c-p" data-field={`credentials.items.${r.i}.body`}>{r.body}</p>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .cred { padding: clamp(40px,5vw,64px) 0; background-color: var(--night); color: var(--cream); }
  .c-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%,220px),1fr));
    gap: 24px clamp(24px,4vw,48px);
  }
  .c-item { min-width: 0; }
  .c-h3 { margin: 0 0 4px; font-family: var(--disp); font-weight: 400; font-size: 20px; color: var(--cream); }
  .c-p { margin: 0; font-size: 14px; color: var(--sage); }
</style>
