---
/**
 * florist / CredentialsBS — "good to know": a quiet strip between two
 * hairlines — a tracked caps eyebrow and a modest Gilda headline, centred,
 * over a row of centred facts, each a rose Gilda title over a small soft line.
 *
 * Editable hooks: credentials.tag · credentials.headline ·
 * credentials.items.${i}.title · credentials.items.${i}.body (ORIGINAL index;
 * the value may arrive as desc / detail / label through the builder's alias
 * map, the hook always spells the canonical key).
 *
 * R2 — registrations, receipts, payment channels, accreditations: claims only
 * the owner may make. Nothing derives this block (astro-builder switches it
 * off when empty), and no seal, tick or badge is drawn — a drawn badge is a
 * visual claim of certification. With no filled row the section is absent.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const str = (v: any): string => String(v ?? '').trim();
const K = (content as any).credentials || {};
const tag = str(K.tag);
const headline = str(K.headline);
const items: any[] = Array.isArray(K.items) ? K.items : (Array.isArray(K) ? K : []);
const rows = items
  .map((it: any, i: number) => ({
    title: str(it?.title ?? it?.label),
    body: str(it?.body ?? it?.desc ?? it?.detail ?? it?.description),
    i,
  }))
  .filter((r: { title: string; body: string }) => r.title || r.body);
---
{rows.length > 0 && (
  <section class="cr" id="credentials">
    <div class="k-wrap">
      {(tag || headline) && (
        <div class="cr-head">
          {tag && <p class="cr-tag" data-field="credentials.tag">{tag}</p>}
          {headline && <h2 class="cr-h2" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cr-grid">
        {rows.map((r) => (
          <div class="cr-item">
            {r.title && <h3 class="cr-t" data-field={`credentials.items.${r.i}.title`}>{r.title}</h3>}
            {r.body && <p class="cr-b" data-field={`credentials.items.${r.i}.body`}>{r.body}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cr {
    padding: clamp(40px, 5vw, 64px) 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .cr-head { text-align: center; }
  .cr-tag {
    margin: 0; font-size: 12px; font-weight: 500; letter-spacing: .28em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  .cr-h2 {
    margin: 8px 0 0; font-family: var(--disp); font-weight: 400;
    font-size: clamp(24px, 2.6vw, 32px); line-height: 1.2; overflow-wrap: break-word;
  }
  .cr-head > :first-child { margin-top: 0; }
  .cr-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 24px clamp(16px, 3vw, 32px); margin-top: 28px; text-align: center;
  }
  .cr-grid:first-child { margin-top: 0; }
  .cr-item { min-width: 0; }
  .cr-t {
    margin: 0 0 4px; font-family: var(--disp); font-weight: 400; font-size: 20px;
    color: var(--rose-ink); overflow-wrap: break-word;
  }
  .cr-b { margin: 0; font-size: 14px; color: var(--ink-soft); }
</style>
