---
/**
 * florist / PageBR — Bloom. First variant of the florist family.
 * Full-bleed hero photograph behind an inset hairline frame, a frosted cream
 * nav bar sitting inside that frame, Playfair Display, dusty-rose accent.
 *
 * LETTER. The design arrived as "L" — salonspa:L. data-page codes are one
 * GLOBAL sequence across every family, not one per family, and A..Z / AA..BQ
 * were taken. BR is this variant's code everywhere: the folder, data-page,
 * the heroStyle, the preview. See FloristSpine for the four other letters it
 * came with and what they would have done.
 *
 * Section components are the barbershop category's *F set. They are entirely
 * token-driven — no `data-page` anchors of their own, no barbershop-specific
 * copy fields — so FloristSpine's primitives plus the tokens below restyle
 * all fifteen of them. Fork them into `florist/<section>/` only when the
 * florist needs different STRUCTURE, not different colour.
 *
 * Palette + font tokens are scoped to html[data-page="BR"] so sister wrappers
 * imported by index.astro don't bleed their tokens here.
 *
 * ACCENT — the dusty rose is the DEFAULT, not a hard-coded colour. It is set
 * on --brass / --brass-bright, the tokens every section and the spine read,
 * so an admin Color Scheme override repaints it across the page. The Leaflet
 * marker below hard-codes its fill, exactly as every barbershop wrapper does.
 *
 * TWO ACCENTS, MIRRORED FROM GLACIER. #A4585E was chosen to clear AA on the
 * cream (4.72:1 on --paper) and it does. On --ink it is 2.44:1, and the
 * shared sections spend --brass there too: the footer's column headings, the
 * featured review's stars, the ring round the about stamp, a hovered service
 * card's numeral. The design already names the right colour for that ground —
 * --brass-bright is "the pale tone used for accents on dark", 5.34:1 on --ink
 * — but the *F sections only ever read --brass. So the dark grounds redeclare
 * --brass as --brass-bright on themselves (see __darkGroundCss); nothing
 * changes on the cream half of the page, where the rose already works.
 *
 * STATED, NOT SILENTLY FIXED: the hero frame's rgba(paper,.42) hairline and
 * the nav bar's --line border are decorative and gate no control. The hero
 * is only as legible as the owner's photograph allows — hero.scrim exists
 * because of that, and `strong` is the answer to a bright, busy image.
 */
import HeaderBR from './header/HeaderBR.astro';
import HeroBR from './hero/HeroBR.astro';
import TrustF from '../barbershop/trust/TrustF.astro';
import AboutF from '../barbershop/about/AboutF.astro';
import ServicesF from '../barbershop/services/ServicesF.astro';
import WhyF from '../barbershop/why/WhyF.astro';
import HowF from '../barbershop/how/HowF.astro';
import TestimonialsF from '../barbershop/testimonials/TestimonialsF.astro';
import GalleryF from '../barbershop/gallery/GalleryF.astro';
import FaqF from '../barbershop/faq/FaqF.astro';
import AreaF from '../barbershop/area/AreaF.astro';
import CredentialsF from '../barbershop/credentials/CredentialsF.astro';
import LocationF from '../barbershop/location/LocationF.astro';
import MarqueeF from '../barbershop/marquee/MarqueeF.astro';
import CtaBandF from '../barbershop/ctaBand/CtaBandF.astro';
import FooterF from '../barbershop/footer/FooterF.astro';
import FloristSpine from './FloristSpine.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
// lockVariant: per-variant palette wins when admin leaves Color Scheme on auto.
const { scheme: __themeScheme, pairing: __resolvedPairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
// FONT-PAIRING SENTINEL. lib/astro-builder.ts defaults layout.fontPairing to
// the literal 'modern' whenever the owner never opened the font picker, and
// lockVariant only blanks ''/'auto'/'default'. Without this line
// buildOverrideCss swaps Space Grotesk + Inter in over Playfair Display with
// !important on nearly every real site. astro-builder's DEFAULT is treated as
// unset; a deliberate pick of any other pairing still applies. Same two lines
// as hospitality/PageBJ, trades/PageBQ and barbershop/PageBP.
const __themePairing = __resolvedPairing === 'modern' ? '' : __resolvedPairing;
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
// The dark-ground accent. Declares --brass on the dark ELEMENTS themselves,
// not per rule: Astro scopes every compound of a section's selectors, so a
// wrapper rule cannot out-specify most of them, but a custom property set on
// the element reaches every rule inside it whatever its weight.
// Gated on the SCHEME, not on __overrideCss — a font pick alone makes the
// override block non-empty while leaving this palette exactly as declared.
// An explicit scheme brings its own --brass / --brass-bright pair, and the
// family then behaves exactly as its barbershop siblings do.
const __darkGroundCss = __themeScheme ? '' : `
html[data-page="BR"] section.ink-sect,
html[data-page="BR"] footer,
html[data-page="BR"] .feat,
html[data-page="BR"] .about-media .stamp,
html[data-page="BR"] .svc:hover {
  --brass: var(--brass-bright); --on-brass: var(--ink);
}`;
---

<!DOCTYPE html>
<html lang="en" data-page="BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Jost:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}
  <style is:global>
    html[data-page="BR"] {
      --ink: #43302B; --ink-2: #56403A; --ink-3: #6B5049;
      --paper: #FAF6F0; --paper-2: #F1E7DB;
      --ink-rgb: 67,48,43; --paper-rgb: 250,246,240; --brass-rgb: 164,88,94;
      /* Accent is the darker rose so 11.5px labels on the trust and CTA bands
         clear AA against cream (4.88:1). --brass-bright is the lighter tone
         used for accents ON dark, where it has room to be pale. */
      --brass: #A4585E; --brass-bright: #D89A9E;
      --line: rgba(67,48,43,.14); --line-light: rgba(250,246,240,.18);
      --muted: rgba(67,48,43,.68); --muted-light: rgba(250,246,240,.68);
      /* Contrast tokens — text colours that stay legible on each background. */
      --on-brass: #FDFAF6; --on-ink: #FAF6F0; --on-paper: #43302B;
      --display: "Playfair Display", serif;
      --cond: "Jost", sans-serif;
      --serif: "Cormorant Garamond", serif;
      --body: "Manrope", sans-serif;
      --pad: clamp(20px, 5vw, 96px);
      --maxw: 1280px;
    }
  </style>
  <FloristSpine />
  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
  <style is:global set:html={__darkGroundCss}></style>
</head>
<body>
  <HeaderBR layout={layout} content={content} />
  <main id="top">
    {visibility.heroSection !== false && <HeroBR content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustF content={content} />}
    {visibility.aboutSection !== false && <AboutF content={content} />}
    {visibility.servicesSection !== false && <ServicesF content={content} />}
    {visibility.whyUsBlock !== false && <WhyF content={content} />}
    {visibility.howItWorksBlock !== false && <HowF content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsF content={content} />}
    {visibility.gallerySection !== false && <GalleryF content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqF content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaF content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsF content={content} />}
    {visibility.locationBlock !== false && <LocationF content={content} layout={layout} />}
    {visibility.marqueeBlock !== false && <MarqueeF content={content} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandF content={content} layout={layout} />}
  <FooterF layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
      var hdr = document.querySelector('header.nav');
      if (hdr) {
        var onScroll = function () { if (window.scrollY > 16) hdr.classList.add('scrolled'); else hdr.classList.remove('scrolled'); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
      // The name is LocationF's contract, shared with the barbershop wrappers:
      // it polls for window.__barbershopInitMap, so this must not be renamed.
      window.__barbershopInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return; el.innerHTML = '';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19 }).addTo(map);
        var icon = L.divIcon({ className: '', html: '<div style="width:22px;height:22px;background:#A4585E;border:3px solid #43302B;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 3px 8px rgba(48,30,26,.35);"></div>', iconSize: [22, 22], iconAnchor: [11, 22] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
