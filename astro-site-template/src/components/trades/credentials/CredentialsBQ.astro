---
/**
 * trades / CredentialsBQ — the accountability row: ruled columns, each opened
 * by a short hazard bar rather than a badge glyph. The bar is deliberate — an
 * invented shield or tick icon next to "DTI registered" reads as a verification
 * mark this page cannot issue, so the design uses a rule instead.
 *
 * EDITABLE HOOKS
 *   credentials.tag / credentials.headline (set:html)
 *   credentials.items.N.title
 *   credentials.items.N.body   (legacy `desc` still read)
 *
 * NEVER FABRICATED: no licence, registration or insurance line is invented, and
 * the count is never padded to four. The section hides entirely when the owner
 * listed none — which is the honest state for most one-person shops.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title?: string; body?: string; desc?: string };
const raw: Item[] = Array.isArray(cred.items)
  ? cred.items
  : (Array.isArray(cred) ? cred : []);
const items = raw.filter((it) => it && (it.title || it.body || it.desc));
---
{items.length > 0 && (
  <section class="sec creds">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="kick" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="h2" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cr-row">
        {items.map((item, i) => {
          const body = item.body ?? item.desc;
          return (
            <div class="cr-cell reveal">
              <div class="cr-bar" aria-hidden="true"></div>
              {item.title && <h3 class="cr-t" data-field={`credentials.items.${i}.title`}>{item.title}</h3>}
              {body && <p class="body cr-b" data-field={`credentials.items.${i}.body`}>{body}</p>}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .cr-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .cr-cell { padding: clamp(24px, 2.6vw, 32px) clamp(18px, 2.2vw, 28px); border-inline-end: 1px solid var(--line); }
  .cr-cell:first-child { padding-inline-start: 0; }
  .cr-cell:last-child { border-inline-end: none; padding-inline-end: 0; }
  .cr-bar { width: 34px; height: 4px; background-color: var(--accent); margin-bottom: 18px; }
  .cr-t { font-family: var(--disp); font-weight: 500; font-size: 15px; letter-spacing: .12em; margin-bottom: 8px; }
  .cr-b { font-size: 14.5px; }
  @media (max-width: 760px) {
    .cr-cell { padding: 22px 0; border-inline-end: none; border-block-end: 1px solid var(--line); }
    .cr-cell:last-child { border-block-end: none; padding-bottom: 0; }
  }
</style>
