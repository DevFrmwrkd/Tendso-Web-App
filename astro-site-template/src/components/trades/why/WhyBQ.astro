---
/**
 * trades / WhyBQ — the reasons, as three ruled columns each opened by an
 * oversized hazard numeral. The numeral is the block's whole visual idea: at
 * ~88px it is the largest non-headline type on the page, which is what stops
 * three paragraphs of prose reading as filler.
 *
 * Anchors #why so a nav link labelled "Why us" has somewhere honest to land.
 *
 * EDITABLE HOOKS
 *   why.tag / why.headline (set:html)
 *   why.items.N.title
 *   why.items.N.body        (legacy `desc` / `description` still read)
 *
 * THE NUMERAL IS DECORATIVE — drawn from the row index, carrying no field, and
 * aria-hidden so a screen reader hears the reason rather than a count.
 *
 * NEVER FABRICATED: no reason is invented and the count is never padded to
 * three. The section hides entirely when the owner listed none.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
type Item = { title?: string; body?: string; desc?: string; description?: string };
const raw: Item[] = Array.isArray(why.items) ? why.items : [];
const items = raw.filter((it) => it && (it.title || it.body || it.desc || it.description));
---
{items.length > 0 && (
  <section class="sec why" id="why">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="kick" data-field="why.tag">{tag}</span>}
          {headline && <h2 class="h2" data-field="why.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="why-grid">
        {items.map((item, i) => {
          const body = item.body ?? item.desc ?? item.description;
          return (
            <div class="why-cell reveal">
              <div class="fig why-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
              {item.title && <h3 class="why-t" data-field={`why.items.${i}.title`}>{item.title}</h3>}
              {body && <p class="body" data-field={`why.items.${i}.body`}>{body}</p>}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  /* auto-fit, so two reasons are two full columns rather than two thirds of a
     row and a gap. */
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .why-cell { padding: clamp(28px, 3.4vw, 44px) clamp(20px, 2.4vw, 32px); border-inline-end: 1px solid var(--line); }
  .why-cell:first-child { padding-inline-start: 0; }
  .why-cell:last-child { border-inline-end: none; padding-inline-end: 0; }
  .why-n { font-size: clamp(56px, 7vw, 88px); color: var(--accent); margin-bottom: 20px; }
  .why-t { font-family: var(--disp); font-weight: 500; font-size: 23px; letter-spacing: .02em; margin-bottom: 12px; }
  @media (max-width: 760px) {
    .why-cell { padding: 26px 0; border-inline-end: none; border-block-end: 1px solid var(--line); }
    .why-cell:last-child { border-block-end: none; padding-bottom: 0; }
    .why-n { margin-bottom: 12px; }
  }
</style>
