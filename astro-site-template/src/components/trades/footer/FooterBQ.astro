---
/**
 * trades / FooterBQ — the deep-black foot: the marked wordmark and a line about
 * the shop on the left, then the sections and the contact columns. A ruled
 * bottom bar carries the owner's own closing notes.
 *
 * Every column auto-hides when empty, collapsing to the design's minimal
 * footer rather than printing an empty heading.
 *
 * EDITABLE HOOKS
 *   footer.brand / footer.locality / footer.blurb
 *   footer.explore.title + footer.explore.links.N.text / .href
 *   footer.visit.title  + footer.visit.lines.N
 *   footer.social.N.platform / .url
 *   footer.notes.N
 *   hero.cta1.text / .href — the sign-off link, the SAME CTA as the bar and the
 *                            hero, so the page never closes on a fourth wording
 *                            of one action
 *
 * NEVER FABRICATED: with no business name the wordmark is omitted rather than
 * printing a placeholder; with no notes the bottom bar carries nothing but the
 * rule. No copyright line, no "all rights reserved" and no year is invented —
 * an owner who wants one types it into footer.notes.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;

// Anchor guard — see the long note in HeaderBQ. Kept identical in every sibling.
const PAGE_ANCHORS = new Set(['main', 'shop', 'jobs', 'why', 'work', 'process', 'reviews', 'visit', 'coverage', 'faq', 'quote']);
const ANCHOR_ALIAS: Record<string, string> = {
  about: 'shop', services: 'jobs', gallery: 'work', how: 'process',
  testimonials: 'reviews', location: 'visit', contact: 'visit', area: 'coverage',
  reserve: 'quote', book: 'quote',
};
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const id = href.slice(1);
  if (PAGE_ANCHORS.has(id)) return href;
  const alias = ANCHOR_ALIAS[id];
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};

const f = (content as any).footer || {};
const brand = f.brand || layout.businessName || '';
const locality = f.locality || '';
const blurb = f.blurb || f.brand_blurb || '';
const exploreTitle = f.explore?.title || 'Sections';
const explore: Array<{ text?: string; href?: string; i: number }> =
  (Array.isArray(f.explore?.links) ? f.explore.links : [])
    .map((l: any, i: number) => ({ ...l, href: onPage(l.href, ''), i }))
    .filter((l: any) => l.href && l.text);
const visitTitle = f.visit?.title || 'Contact';
const visitLines: string[] = Array.isArray(f.visit?.lines) && f.visit.lines.length
  ? f.visit.lines.filter((l: any) => typeof l === 'string' && l.trim())
  : ([layout.contact?.address, layout.contact?.phone].filter(Boolean) as string[]);
const social: Array<{ platform?: string; url?: string }> = Array.isArray(f.social) && f.social.length
  ? f.social.filter((s: any) => s && s.url && s.platform)
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks.filter((s: any) => s && s.url && s.platform) : []);
const notes: string[] = Array.isArray(f.notes) ? f.notes.filter((n: any) => typeof n === 'string' && n.trim()) : [];
const phone = layout.contact?.phone || (content as any).location?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
const hero = (content as any).hero || {};
const signText = hero.cta1?.text || '';
const signHref = onPage(hero.cta1?.href, '#visit');
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="fcol fcol-brand">
        {brand && (
          <div class="fbrand">
            <span class="mark" aria-hidden="true"></span>
            <span class="fbn" data-field="footer.brand">{brand}</span>
          </div>
        )}
        {locality && <div class="label floc" data-field="footer.locality">{locality}</div>}
        {blurb && <p class="body fblurb" data-field="footer.blurb">{blurb}</p>}
        {signText && (
          <a href={signHref} class="linkc fsign" rel="noopener" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{signText}</a>
        )}
        {social.length > 0 && (
          <div class="fsocial">
            {social.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 data-field={`footer.social.${i}.platform`} data-href-field={`footer.social.${i}.url`}>{s.platform}</a>
            ))}
          </div>
        )}
      </div>
      {explore.length > 0 && (
        <div class="fcol">
          <div class="label fh" data-field="footer.explore.title">{exploreTitle}</div>
          {explore.map((l) => (
            <p class="fl"><a href={l.href} data-field={`footer.explore.links.${l.i}.text`} data-href-field={`footer.explore.links.${l.i}.href`}>{l.text}</a></p>
          ))}
        </div>
      )}
      {visitLines.length > 0 && (
        <div class="fcol">
          <div class="label fh" data-field="footer.visit.title">{visitTitle}</div>
          {visitLines.map((line, i) => (
            line === phone && phone
              ? <p class="fl"><a href={`tel:${phoneDigits}`} data-field={`footer.visit.lines.${i}`}>{line}</a></p>
              : <p class="fl" data-field={`footer.visit.lines.${i}`}>{line}</p>
          ))}
        </div>
      )}
    </div>
    {notes.length > 0 && (
      <div class="foot-btm">
        {notes.map((n, i) => (<span class="label" data-field={`footer.notes.${i}`}>{n}</span>))}
      </div>
    )}
  </div>
</footer>
<style>
  .foot { background-color: var(--paper-3); color: var(--ink); padding-block: clamp(40px, 5vw, 56px) 24px; }
  .foot-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 3.4vw, 44px); padding-bottom: clamp(26px, 3vw, 36px); border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: minmax(0, 1fr); gap: 26px; } }
  .fbrand { display: flex; align-items: center; gap: 11px; }
  .fbrand .mark { width: 20px; height: 20px; background-color: var(--accent); clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%); flex: none; }
  .fbn { font-family: var(--disp); font-weight: 700; font-size: 23px; letter-spacing: .04em; text-transform: uppercase; }
  .floc { display: block; margin-top: 8px; }
  .fblurb { margin: 12px 0 16px; max-width: 40ch; font-size: 14.5px; }
  .fsign { margin-bottom: 4px; }
  .fh { display: block; margin-bottom: 14px; }
  .fl { margin: 0 0 9px; font-size: 15px; color: var(--ink-soft); }
  .fl a:hover { color: var(--accent); }
  .fsocial { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
  .fsocial a {
    font-family: var(--disp); font-weight: 400; font-size: 11px;
    letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft);
    border: 1px solid var(--line); padding: 7px 12px;
    transition: color .18s ease, border-color .18s ease;
  }
  .fsocial a:hover { color: var(--accent); border-color: var(--accent); }
  .foot-btm { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding-top: 18px; }
  @media (prefers-reduced-motion: reduce) { .fsocial a { transition: none; } }
</style>
