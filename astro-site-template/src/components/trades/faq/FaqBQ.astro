---
/**
 * trades / FaqBQ — the questions, laid across two ruled columns. Plain
 * question-and-answer pairs rather than an accordion: on a shop page every
 * answer is short, and hiding five short answers behind five taps costs more
 * than the vertical space it saves.
 *
 * EDITABLE HOOKS
 *   faq.tag / faq.headline (set:html)
 *   faq.items.N.q
 *   faq.items.N.a   (set:html, so an owner's own link inside an answer survives)
 *
 * THE TWO COLUMNS ARE CSS, NOT A SPLIT ARRAY. An earlier sibling sliced the
 * list in half in the frontmatter and re-derived the second half's field
 * indices with `mid + j` — one off-by-one there and the editor writes an admin's
 * answer into the wrong question. Here the single list renders in source order
 * and `columns` does the layout, so every data-field index is simply `i`.
 *
 * NEVER FABRICATED: no question and no answer is invented. The section hides
 * entirely when the owner wrote none.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q?: string; a?: string };
const raw: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
const items = raw.filter((it) => it && (it.q || it.a));
---
{items.length > 0 && (
  <section class="sec asked" id="faq">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="kick" data-field="faq.tag">{tag}</span>}
        {headline && <h2 class="h2" data-field="faq.headline" set:html={headline}></h2>}
      </div>
      <dl class="qa">
        {items.map((item, i) => (
          <div class="qa-item rowrule reveal">
            {item.q && <dt class="qa-q" data-field={`faq.items.${i}.q`}>{item.q}</dt>}
            {item.a && <dd class="body qa-a" data-field={`faq.items.${i}.a`} set:html={item.a}></dd>}
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
<style>
  .qa { margin: 0; border-top: 1px solid var(--ink-soft); columns: 2; column-gap: 48px; }
  @media (max-width: 860px) { .qa { columns: 1; } }
  /* break-inside keeps a question and its answer together when the column
     breaks; without it a heading strands at the foot of column one. */
  .qa-item { break-inside: avoid; padding: 22px 0; }
  .qa-q { font-family: var(--disp); font-weight: 500; font-size: 19px; letter-spacing: .02em; text-transform: uppercase; color: var(--ink); margin: 0 0 8px; }
  .qa-a { margin: 0; font-size: 15px; }
  .qa-a :global(a) { color: var(--accent); border-bottom: 1px solid currentColor; }
</style>
