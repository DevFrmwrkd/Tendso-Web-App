---
/**
 * Astro entry page.
 *
 * Routes between template "letters" based on `customizations.heroStyle`
 * in site-data.json:
 *
 *   "generic:A"     → Ironwood Coffee
 *   "generic:B"     → Stillwater Studio
 *   "generic:C"     → Cedar & Stone
 *   "generic:D"     → Northpoint IT
 *   "generic:E"     → Wash House
 *   "barbershop:F"  → Forge (default brass)
 *   "barbershop:G"  → Forge Cinematic
 *   "barbershop:H"  → Forge Kinetic (black + green)
 *   "barbershop:I"  → Forge Minimal (neutral)
 *   "barbershop:J"  → Forge Stacked (paper + dark red)
 *   "barbershop:BP" → Glacier (ice blue + didone · full-bleed photo)
 *   "salonspa:K"    → Atelier (pearl + brass · Cormorant Garamond + Jost)
 *   "salonspa:L"    → Botanica (sage + cream · Spectral + Mulish)
 *   "salonspa:M"    → Clinic (mist + teal · Tenor Sans + Karla)
 *   "salonspa:N"    → Vogue (mauve pink · DM Serif Display + DM Sans)
 *   "salonspa:O"    → Bloom (mauve + cream · Marcellus + Nunito Sans)
 *   "autoshop:P"    → Foundry (concrete + hazard orange · Archivo + Spline Sans)
 *   "autoshop:Q"    → Meridian
 *   "autoshop:R"    → Volt
 *   "autoshop:S"    → Redline
 *   "autoshop:T"    → Maple Street
 *   "restaurant:U"  → Harvest (rustic)
 *   "restaurant:V"  → Atelier (minimal)
 *   "restaurant:W"  → Press (bold)
 *   "restaurant:X"  → Ember (cinematic)
 *   "restaurant:Y"  → Garden (playful)
 *   "restaurant:AE" → Smoke & Banana Leaf (grill house)
 *   "shirtstore:Z"  → Editorial
 *   "shirtstore:AA" → Streetwear
 *   "shirtstore:AB" → Artisan
 *   "shirtstore:AC" → Modern
 *   "shirtstore:AD" → Kinetic
 *   "autoshop:AF"   → Job-Sheet Industrial (v03)
 *   "retail:AG"     → Broadsheet Catalog (v03)
 *   "medical:AH"    → Clinical Editorial (v03)
 *   "fitness:AI"    → Brutalist Fight Poster (v03)
 *   "education:AJ"  → Notebook Modern (v03)
 *   "trades:AK"     → Blueprint Cyanotype (v03)
 *   "foodcraft:AL"  → Pastel Deco Panadería (v03)
 *   "foodcraft:BL"  → Kalinaw Coffee · cream + rust, a café that roasts its own
 *   "foodcraft:BM"  → Tahanan Cafe · white + walnut, a ruled editorial café
 *   "foodcraft:BN"  → Panday Coffee Works · bone + rust, a working roastery
 *   "foodcraft:BO"  → Sipsip Tea Bar · blush + ultraviolet, soft and rounded
 *
 *   — v4 hero batch (one flagship per bucket) —
 *   "restaurant:AM" → Kalan · Mercado Nocturne
 *   "salonspa:AN"   → Héla · Poblacion Atelier
 *   "retail:AO"     → Domingo · Catálogo
 *   "autoshop:AP"   → Vulca Garage & Detailing
 *   "medical:AQ"    → Batis Dental Studio
 *   "fitness:AR"    → Kalasag Strength Co.
 *   "services:AS"   → Labaná Laundry & Press (new family)
 *   "education:AT"  → Talíno Learning Studio
 *   "trades:AU"     → Volt & Line Electrical Services
 *
 *   "hospitality:BI" → Palm Hour · hotels, villas & short stays (new family)
 *   "hospitality:BJ" → Kubo Stays · rooms in an owner-hosted house
 *   "hospitality:BK" → Villa Marindu · a whole private villa, night + brass
 *
 *   "trades:BQ"      → Bakal Fabrication Works · steel fabrication, welding & metal shops
 *
 * Each PageX wrapper produces the full document (its own doctype, theme,
 * fonts, leaflet boot) so they do not compose with BaseLayout.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageA from '../components/generic/PageA.astro';
import PageB from '../components/generic/PageB.astro';
import PageC from '../components/generic/PageC.astro';
import PageD from '../components/generic/PageD.astro';
import PageE from '../components/generic/PageE.astro';
import PageF from '../components/barbershop/PageF.astro';
import PageG from '../components/barbershop/PageG.astro';
import PageH from '../components/barbershop/PageH.astro';
import PageI from '../components/barbershop/PageI.astro';
import PageJ from '../components/barbershop/PageJ.astro';
import PageBP from '../components/barbershop/PageBP.astro';
import PageK from '../components/salonspa/PageK.astro';
import PageL from '../components/salonspa/PageL.astro';
import PageM from '../components/salonspa/PageM.astro';
import PageN from '../components/salonspa/PageN.astro';
import PageO from '../components/salonspa/PageO.astro';
import PageP from '../components/autoshop/PageP.astro';
import PageQ from '../components/autoshop/PageQ.astro';
import PageR from '../components/autoshop/PageR.astro';
import PageS from '../components/autoshop/PageS.astro';
import PageT from '../components/autoshop/PageT.astro';
import PageU from '../components/restaurant/PageU.astro';
import PageV from '../components/restaurant/PageV.astro';
import PageW from '../components/restaurant/PageW.astro';
import PageX from '../components/restaurant/PageX.astro';
import PageY from '../components/restaurant/PageY.astro';
import PageAE from '../components/restaurant/PageAE.astro';
import PageAM from '../components/restaurant/PageAM.astro';
import PageZ from '../components/shirtstore/PageZ.astro';
import PageAA from '../components/shirtstore/PageAA.astro';
import PageAB from '../components/shirtstore/PageAB.astro';
import PageAC from '../components/shirtstore/PageAC.astro';
import PageAD from '../components/shirtstore/PageAD.astro';
import PageAF from '../components/autoshop/PageAF.astro';
import PageAG from '../components/retail/PageAG.astro';
import PageAH from '../components/medical/PageAH.astro';
import PageAI from '../components/fitness/PageAI.astro';
import PageAJ from '../components/education/PageAJ.astro';
import PageAK from '../components/trades/PageAK.astro';
import PageAL from '../components/foodcraft/PageAL.astro';
import PageBL from '../components/foodcraft/PageBL.astro';
import PageBM from '../components/foodcraft/PageBM.astro';
import PageBN from '../components/foodcraft/PageBN.astro';
import PageBO from '../components/foodcraft/PageBO.astro';
import PageAN from '../components/salonspa/PageAN.astro';
import PageAO from '../components/retail/PageAO.astro';
import PageAP from '../components/autoshop/PageAP.astro';
import PageAQ from '../components/medical/PageAQ.astro';
import PageAR from '../components/fitness/PageAR.astro';
import PageAS from '../components/services/PageAS.astro';
import PageAT from '../components/education/PageAT.astro';
import PageAU from '../components/trades/PageAU.astro';
import PageBQ from '../components/trades/PageBQ.astro';
import PageAV from '../components/layouts/PageAV.astro';
import PageAW from '../components/layouts/PageAW.astro';
import PageAX from '../components/layouts/PageAX.astro';
import PageAY from '../components/layouts/PageAY.astro';
import PageAZ from '../components/layouts/PageAZ.astro';
import PageBA from '../components/layouts/PageBA.astro';
import PageBB from '../components/filipino/PageBB.astro';
import PageBC from '../components/filipino/PageBC.astro';
import PageBD from '../components/filipino/PageBD.astro';
import PageBE from '../components/filipino/PageBE.astro';
import PageBF from '../components/filipino/PageBF.astro';
import PageBG from '../components/filipino/PageBG.astro';
import PageBH from '../components/filipino/PageBH.astro';
import PageBI from '../components/hospitality/PageBI.astro';
import PageBJ from '../components/hospitality/PageBJ.astro';
import PageBK from '../components/hospitality/PageBK.astro';
import siteData from '../data/site-data.json';

// Live-editor support: template / colour / font / hidden-sections can be driven
// by URL params (?hero=restaurant:U&scheme=blue&font=modern&off=faq,gallery) so the
// /editor.html preview iframe can re-render without writing site-data.json.
const __sd = siteData as any;
const __q = Astro.url.searchParams;
const __pScheme = __q.get('scheme');
const __pFont = __q.get('font');
const __pOff = (__q.get('off') || '').split(',').map((s) => s.trim()).filter(Boolean);
const customizations = __sd.customizations ?? {};
const content = __sd.content ?? {};
const layout = {
  ...(__sd.layout ?? {}),
  ...(__pScheme ? { colorScheme: __pScheme, colorSchemeId: __pScheme } : {}),
  ...(__pFont ? { fontPairing: __pFont, fontPairingId: __pFont } : {}),
};
const visibility: Record<string, any> = { ...(__sd.visibility ?? {}) };
for (const k of __pOff) { visibility[k] = false; }

const heroStyle: string = (__q.get('hero') || customizations.heroStyle) ?? '';
const data = { ...__sd, layout, visibility, customizations: { ...customizations, heroStyle } };
const genericMatch = /^generic:([A-E])$/.exec(heroStyle);
const genericLetter = genericMatch ? genericMatch[1] : null;
const barbershopMatch = /^barbershop:([F-J]|BP)$/.exec(heroStyle);
const barbershopLetter = barbershopMatch ? barbershopMatch[1] : null;
const salonspaMatch = /^salonspa:([K-O]|AN)$/.exec(heroStyle);
const salonspaLetter = salonspaMatch ? salonspaMatch[1] : null;
const autoshopMatch = /^autoshop:([P-T]|AF|AP)$/.exec(heroStyle);
const autoshopLetter = autoshopMatch ? autoshopMatch[1] : null;
const restaurantMatch = /^restaurant:([U-Y]|A[EM])$/.exec(heroStyle);
const restaurantLetter = restaurantMatch ? restaurantMatch[1] : null;
const shirtstoreMatch = /^shirtstore:(Z|A[A-D])$/.exec(heroStyle);
const shirtstoreLetter = shirtstoreMatch ? shirtstoreMatch[1] : null;
const retailMatch = /^retail:(AG|AO)$/.exec(heroStyle);
const retailLetter = retailMatch ? retailMatch[1] : null;
const medicalMatch = /^medical:(AH|AQ)$/.exec(heroStyle);
const medicalLetter = medicalMatch ? medicalMatch[1] : null;
const fitnessMatch = /^fitness:(AI|AR)$/.exec(heroStyle);
const fitnessLetter = fitnessMatch ? fitnessMatch[1] : null;
const educationMatch = /^education:(AJ|AT)$/.exec(heroStyle);
const educationLetter = educationMatch ? educationMatch[1] : null;
const tradesMatch = /^trades:(AK|AU|BQ)$/.exec(heroStyle);
const tradesLetter = tradesMatch ? tradesMatch[1] : null;
const foodcraftMatch = /^foodcraft:(AL|BL|BM|BN|BO)$/.exec(heroStyle);
const foodcraftLetter = foodcraftMatch ? foodcraftMatch[1] : null;
const servicesMatch = /^services:(AS)$/.exec(heroStyle);
const servicesLetter = servicesMatch ? servicesMatch[1] : null;
const layoutsMatch = /^layouts:(A[V-Z]|BA)$/.exec(heroStyle);
const layoutsLetter = layoutsMatch ? layoutsMatch[1] : null;
const filipinoMatch = /^filipino:(B[B-H])$/.exec(heroStyle);
const filipinoLetter = filipinoMatch ? filipinoMatch[1] : null;
const hospitalityMatch = /^hospitality:(BI|BJ|BK)$/.exec(heroStyle);
const hospitalityLetter = hospitalityMatch ? hospitalityMatch[1] : null;
const anyLetter = genericLetter || barbershopLetter || salonspaLetter
  || autoshopLetter || restaurantLetter || shirtstoreLetter
  || retailLetter || medicalLetter || fitnessLetter || educationLetter || tradesLetter || foodcraftLetter
  || servicesLetter || layoutsLetter || filipinoLetter || hospitalityLetter;
---

{genericLetter === 'A' && <PageA siteData={data} />}
{genericLetter === 'B' && <PageB siteData={data} />}
{genericLetter === 'C' && <PageC siteData={data} />}
{genericLetter === 'D' && <PageD siteData={data} />}
{genericLetter === 'E' && <PageE siteData={data} />}
{barbershopLetter === 'F' && <PageF siteData={data} />}
{barbershopLetter === 'G' && <PageG siteData={data} />}
{barbershopLetter === 'H' && <PageH siteData={data} />}
{barbershopLetter === 'I' && <PageI siteData={data} />}
{barbershopLetter === 'J' && <PageJ siteData={data} />}
{barbershopLetter === 'BP' && <PageBP siteData={data} />}
{salonspaLetter === 'K' && <PageK siteData={data} />}
{salonspaLetter === 'L' && <PageL siteData={data} />}
{salonspaLetter === 'M' && <PageM siteData={data} />}
{salonspaLetter === 'N' && <PageN siteData={data} />}
{salonspaLetter === 'O' && <PageO siteData={data} />}
{autoshopLetter === 'P' && <PageP siteData={data} />}
{autoshopLetter === 'Q' && <PageQ siteData={data} />}
{autoshopLetter === 'R' && <PageR siteData={data} />}
{autoshopLetter === 'S' && <PageS siteData={data} />}
{autoshopLetter === 'T' && <PageT siteData={data} />}
{autoshopLetter === 'AF' && <PageAF siteData={data} />}
{restaurantLetter === 'U' && <PageU siteData={data} />}
{restaurantLetter === 'V' && <PageV siteData={data} />}
{restaurantLetter === 'W' && <PageW siteData={data} />}
{restaurantLetter === 'X' && <PageX siteData={data} />}
{restaurantLetter === 'Y' && <PageY siteData={data} />}
{restaurantLetter === 'AE' && <PageAE siteData={data} />}
{restaurantLetter === 'AM' && <PageAM siteData={data} />}
{shirtstoreLetter === 'Z' && <PageZ siteData={data} />}
{shirtstoreLetter === 'AA' && <PageAA siteData={data} />}
{shirtstoreLetter === 'AB' && <PageAB siteData={data} />}
{shirtstoreLetter === 'AC' && <PageAC siteData={data} />}
{shirtstoreLetter === 'AD' && <PageAD siteData={data} />}
{retailLetter === 'AG' && <PageAG siteData={data} />}
{medicalLetter === 'AH' && <PageAH siteData={data} />}
{fitnessLetter === 'AI' && <PageAI siteData={data} />}
{educationLetter === 'AJ' && <PageAJ siteData={data} />}
{tradesLetter === 'AK' && <PageAK siteData={data} />}
{foodcraftLetter === 'AL' && <PageAL siteData={data} />}
{foodcraftLetter === 'BL' && <PageBL siteData={data} />}
{foodcraftLetter === 'BM' && <PageBM siteData={data} />}
{foodcraftLetter === 'BN' && <PageBN siteData={data} />}
{foodcraftLetter === 'BO' && <PageBO siteData={data} />}
{salonspaLetter === 'AN' && <PageAN siteData={data} />}
{retailLetter === 'AO' && <PageAO siteData={data} />}
{autoshopLetter === 'AP' && <PageAP siteData={data} />}
{medicalLetter === 'AQ' && <PageAQ siteData={data} />}
{fitnessLetter === 'AR' && <PageAR siteData={data} />}
{servicesLetter === 'AS' && <PageAS siteData={data} />}
{layoutsLetter === 'AV' && <PageAV siteData={data} />}
{layoutsLetter === 'AW' && <PageAW siteData={data} />}
{layoutsLetter === 'AX' && <PageAX siteData={data} />}
{layoutsLetter === 'AY' && <PageAY siteData={data} />}
{layoutsLetter === 'AZ' && <PageAZ siteData={data} />}
{layoutsLetter === 'BA' && <PageBA siteData={data} />}
{educationLetter === 'AT' && <PageAT siteData={data} />}
{tradesLetter === 'AU' && <PageAU siteData={data} />}
{tradesLetter === 'BQ' && <PageBQ siteData={data} />}
{filipinoLetter === 'BB' && <PageBB siteData={data} />}
{filipinoLetter === 'BC' && <PageBC siteData={data} />}
{filipinoLetter === 'BD' && <PageBD siteData={data} />}
{filipinoLetter === 'BE' && <PageBE siteData={data} />}
{filipinoLetter === 'BF' && <PageBF siteData={data} />}
{filipinoLetter === 'BG' && <PageBG siteData={data} />}
{filipinoLetter === 'BH' && <PageBH siteData={data} />}
{hospitalityLetter === 'BI' && <PageBI siteData={data} />}
{hospitalityLetter === 'BJ' && <PageBJ siteData={data} />}
{hospitalityLetter === 'BK' && <PageBK siteData={data} />}
{!anyLetter && (
  <BaseLayout
    businessName={layout.businessName ?? ''}
    tagline={layout.tagline ?? ''}
    navLinks={layout.navLinks ?? []}
    socialLinks={layout.socialLinks ?? []}
    colorScheme={layout.colorScheme ?? 'auto'}
    fontPairing={layout.fontPairing ?? 'modern'}
    contact={layout.contact ?? {}}
    navbarStyle={layout.navbarStyle ?? 'A'}
    showScrollTop={false}
    favicon={(siteData as any).favicon}
    ogImage={(siteData as any).ogImage}
  >
    <main class="min-h-screen flex items-center justify-center px-6 py-24">
      <div class="max-w-xl text-center space-y-4">
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">
          {content.hero?.headline ?? layout.businessName ?? 'Coming soon'}
        </h1>
        {content.hero?.description && (
          <p class="text-base md:text-lg text-neutral-600 leading-relaxed">
            {content.hero.description}
          </p>
        )}
      </div>
    </main>
  </BaseLayout>
)}
